diff --git a/tests/player_status_scheduler_test.gd b/tests/player_status_scheduler_test.gd
new file mode 100644
index 0000000000000000000000000000000000000000..9c4e8f002a668485db00b4d8ba41b689900fc8a3
--- /dev/null
+++ b/tests/player_status_scheduler_test.gd
@@ -0,0 +1,84 @@
+extends SceneTree
+const Scheduler = preload("res://scripts/lol2/player_status_scheduler.gd")
+const State = preload("res://scripts/lol2/player_swarm_state.gd")
+var quests: Dictionary = {}
+var commits := 0
+var fail_consumer := false
+var fail_writer := false
+func read_quests() -> Dictionary: return quests
+func commit_quests(staged: Dictionary) -> String:
+	if fail_writer: return "writer refused"
+	quests = staged.duplicate(true)
+	commits += 1
+	return ""
+func consume(staged: Dictionary, tick: Dictionary, _presentation: Dictionary) -> String:
+	staged.consumer_ticks = int(staged.get("consumer_ticks",0)) + int(tick.advanced)
+	return "consumer refused" if fail_consumer else ""
+func _initialize() -> void: run.call_deferred()
+func run() -> void:
+	var scheduler := Scheduler.new()
+	scheduler.setup(read_quests,commit_quests,func(): return true,consume)
+	assert(State.trigger(quests).started)
+	var before := quests.duplicate(true)
+	fail_consumer = true
+	assert(scheduler.advance_microseconds(16667,true).error == "consumer refused")
+	assert(quests == before and commits == 0)
+	fail_consumer = false;fail_writer = true
+	assert(scheduler.advance_microseconds(16667,true).error == "writer refused")
+	assert(quests == before and commits == 0)
+	fail_writer = false
+	assert(scheduler.advance_microseconds(-1,true).has("error") and quests == before)
+	var direct := before.duplicate(true)
+	for i in 120:
+		var running := i%7 != 0
+		var expected := State.advance(direct,16667,running)
+		var result := scheduler.advance_microseconds(16667,running)
+		assert(result == expected and quests.player_swarm == direct.player_swarm)
+		assert(quests.hive_runtime_timing == direct.hive_runtime_timing)
+	assert(commits == 120 and quests.consumer_ticks == 102)
+	var reference := quests.duplicate(true)
+	var accumulated := 0.0
+	var total_us := 0
+	for i in 3600:
+		var delta := 1.0/60.0
+		accumulated += delta * 1000000.0
+		var micros := floori(accumulated)
+		accumulated -= micros
+		total_us += micros
+		var expected := State.advance(reference,micros,true)
+		var result := scheduler.advance_seconds(delta,true)
+		assert(result == expected)
+		assert(quests.hive_runtime_timing == reference.hive_runtime_timing)
+		# New process/scene reads the serialized fraction rather than resetting it.
+		quests = JSON.parse_string(JSON.stringify(quests, "", true, true))
+	assert(absf(float(total_us) + accumulated - 60000000.0) < 0.00001)
+	assert(absf(float(quests.player_status_fraction) - accumulated) < 0.00001)
+	var fractional_before := quests.duplicate(true)
+	fail_consumer = true
+	assert(scheduler.advance_seconds(1.0/60.0,true).has("error") and quests == fractional_before)
+	fail_consumer = false
+	for invalid in [-1,INF,NAN,true,null,3601]:
+		assert(scheduler.advance_seconds(invalid,true).has("error") and quests == fractional_before)
+	for invalid in [-0.1,1.0,INF,NAN,true,null]:
+		assert(not State.valid_fraction(invalid))
+	assert(scheduler.process_mode == Node.PROCESS_MODE_ALWAYS)
+	root.add_child(scheduler)
+	for i in 3: await physics_frame
+	var live_before := commits
+	for i in 5: await physics_frame
+	assert(commits == live_before + 5)
+	paused = true
+	await physics_frame
+	var pause_swarm: Dictionary = quests.player_swarm.duplicate(true)
+	var pause_clock: Dictionary = quests.hive_runtime_timing.clock.duplicate(true)
+	var pause_phase: int = quests.hive_runtime_timing.phase
+	var pause_commits := commits
+	for i in 4: await physics_frame
+	assert(commits == pause_commits + 4)
+	assert(quests.player_swarm == pause_swarm and quests.hive_runtime_timing.clock == pause_clock)
+	assert(quests.hive_runtime_timing.phase != pause_phase)
+	paused = false
+	scheduler.queue_free()
+	await process_frame
+	print("PASS status scheduler: shared tick,120 updates, pause gate, transactional consumer/writer failures; actual physics loop/SceneTree pause and3600 fractional JSON continuations")
+	quit(0)

@@ -0,0 +1,54 @@
+#!/usr/bin/env python3
+"""Pack decoded native insect frames, preserving exact RGBA pixels."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from PIL import Image
+
+SOURCE = '36e0d2a0e843126e28d60411ea3e67b3db2f8ea6185bcd6d520271790736ad93'
+
+def pack(source, output):
+    native = json.loads((source / 'manifest.json').read_text())
+    assert native['source_sha256'] == SOURCE
+    output.mkdir(parents=True, exist_ok=False)
+    result = dict(source_sha256=SOURCE, width=316, height=200,
+                  sequences={}, atlas_sha256={}, verified_frames=0,
+                  scope='Private presentation pack; exact decoded RGBA roundtrip. Live placement, timing, audio and health integration not qualified.')
+    for phase, name, count in [(39, 'BugFlyIn', 66), (40, 'BugLoit', 15), (41, 'BugSwat', 10)]:
+        sequence = next(s for s in native['sequences'] if s['name'] == name)
+        assert (sequence['count'], sequence['width'], sequence['height']) == (count, 316, 200)
+        names = []
+        for start in range(0, count, 16):
+            atlas = Image.new('RGBA', (1264, 800))
+            originals = []
+            for frame in range(start, min(start + 16, count)):
+                with Image.open(source / f'{name}_{frame:02d}.png') as indexed:
+                    assert hashlib.sha256(indexed.tobytes()).hexdigest() == sequence['frames'][frame]['indices_sha256']
+                    original = indexed.convert('RGBA')
+                assert original.size == (316, 200)
+                cell = frame - start
+                x, y = cell % 4 * 316, cell // 4 * 200
+                atlas.paste(original, (x, y))
+                originals.append((x, y, original.tobytes()))
+            filename = f'{name}_{start // 16}.png'
+            path = output / filename
+            atlas.save(path)
+            with Image.open(path) as saved:
+                for x, y, pixels in originals:
+                    assert saved.crop((x, y, x + 316, y + 200)).tobytes() == pixels
+                    result['verified_frames'] += 1
+            names.append(filename)
+            result['atlas_sha256'][filename] = hashlib.sha256(path.read_bytes()).hexdigest()
+        result['sequences'][str(phase)] = dict(frames=count, atlases=names)
+    assert result['verified_frames'] == 91
+    (output / 'manifest.json').write_text(json.dumps(result, indent=2) + '\n')
+    return result
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--source', type=Path, required=True)
+    parser.add_argument('--out', type=Path, required=True)
+    args = parser.parse_args()
+    result = pack(args.source, args.out)
+    print(f"PASS {result['verified_frames']} frame roundtrips; {len(result['atlas_sha256'])} atlases")

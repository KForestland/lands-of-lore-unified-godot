 	result["phase"] = scaled % PERIOD
 	result["counter_ticks"] = ticks
 	return result
+
+## E066C writes deltas/gates after the consumers; use that saved previous result
+## during the next iteration. Fixed deltas are multiples of2048, so fraction8
+## is unchanged and the remaining output fields are recoverable from the state.
+static func previous_frame(state: Variant) -> Dictionary:
+	var checked:=advance_native(state,0,false)
+	if checked.has("error"):return checked
+	var sum:=0
+	for sample in state.samples:sum+=int(sample)
+	var fixed:=mini(sum*2048,524288)
+	var gate:=int(state.status_accum)<fixed
+	return {"advanced":true,"fixed":fixed,"delta":(fixed+int(state.fraction8))>>8,"elapsed":(fixed+((int(state.fraction16)-fixed)&65535))>>16,"status_gate":gate,"minute_gate":gate and int(state.seconds)==0}
+
+static func advance_reference_frame(state: Variant, microseconds: Variant, phase: Variant, running: bool = true) -> Dictionary:
+	var next:=advance_reference_time(state,microseconds,phase,running)
+	if next.has("error") or not running:return next
+	var consumed:=previous_frame(state)
+	if consumed.has("error"):return consumed
+	for field in consumed:next[field]=consumed[field]
+	return next

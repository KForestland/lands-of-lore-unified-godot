+#!/usr/bin/env python3
+"""Causal reduction of the FFmpeg VQA v2 frame damage (patch H3, tools/vqa_v2_decode.py).
+
+1. FFmpeg model: libavformat westwood_vqa.c (n6.1.1) appends each top-level VQFL payload to the next VQFR packet;
+   libavcodec vqavideo.c keeps the last sub-chunk index per tag, decodes CBFZ before rendering, renders VPTZ, then adds
+   that single (VQFL's last) CBPZ part and decodes completed groups in place over the old codebook. Reproduces FFmpeg's
+   frames pixel-exactly (all but 11 pixels in two frames, over the cached clips).
+2. Native equivalence: decoding from every VQFL snapshot (CBFZ codebook + its CBPZ parts pending) reproduces the native
+   linear decode exactly, so linear playback that ignores VQFL is the original's own result.
+Run from the project root; uses cached VQA files under tmp/ and FFmpeg. Writes docs/vqa-vqfl-cause-checks.json."""
+import json,runpy,subprocess,sys
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[1];HERE=Path(__file__).resolve().parent
+def run(script):
+    r=subprocess.run([sys.executable,str(HERE/script)],capture_output=True,text=True,cwd=HERE);assert r.returncode==0,r.stderr[-2000:]
+    return [l for l in r.stdout.splitlines() if l.startswith('TOTAL')][-1]
+def main():
+    model=run('_vqfl_ffmpeg_model.py');seek=run('_vqfl_seek_check.py')
+    m=eval(model.split('TOTAL ',1)[1]);s=[int(x) for x in seek.split()[2:7:2]]
+    assert m['ffmpeg_model_exact']>=m['frames']-2 and m['native_differs_explained']>=m['native_differs']-2, model
+    assert s[1]==0 and s[0]>0, seek
+    (ROOT/'docs/vqa-vqfl-cause-checks.json').write_text(json.dumps(dict(ffmpeg_model=m,vqfl_seek_snapshots=dict(consistent=s[0],inconsistent=s[1],clips=s[2])),indent=1)+'\n')
+    print('PASS',model,'|',seek)
+if __name__=='__main__':main()

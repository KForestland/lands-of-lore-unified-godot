+#!/usr/bin/env python3
+"""Stage CHUT direct-attack clip, cues and replacement hotspots from pinned originals.
+
+Outputs a supplementary attack_media.json, NOT rooms.json: runtime integration remains
+separate. No original assets are tracked. Requires ffmpeg and existing published decoders.
+Example: python3 tools/prepare_chut_attack_media.py --game GAME --output-root FRESH
+"""
+import argparse
+import json
+import struct
+import subprocess
+import wave
+from pathlib import Path
+from PIL import Image
+from monastery_media import digest, extract, parse_vqa_chunks, stage_patch
+from prepare_classic_hud import blob
+from prepare_museum_interface import shape
+
+SOURCE = Path(__file__).resolve().with_name('chut_attack_media_source.json')
+
+
+def prepare(game, root, source):
+    archive = (game / 'DAT/CHUT.MIX').read_bytes()
+    assert digest(archive) == source['archive_sha256'], 'CHUT archive mismatch'
+    bank = blob(game, 'LOCALLNG.MIX', source['sound_bank_key'])
+    assert digest(bank) == source['sound_bank_sha256'], 'Sound bank mismatch'
+    out = root / 'assets/lol2/generated/chut_room'
+    cache = root / 'tmp/chut_attack_source'
+    out.mkdir(parents=True)
+    cache.mkdir(parents=True)
+    clip = source['clip']
+    raw, _ = extract(archive, clip['name'])
+    assert digest(raw) == clip['sha256'], 'Attack clip mismatch'
+    path = cache / '2999806E.VQA'
+    path.write_bytes(raw)
+    attack = stage_patch(path, out / '2999806E.ogv', dict(clip, kind='movie'), root)
+    assert attack['audio_samples'] == source['attack_audio_samples']
+    result = {'version': 1, 'attack': attack, 'cues': {}, 'hotspots': []}
+    u32 = lambda data, offset: struct.unpack_from('<I', data, offset)[0]
+    for key, cue in source['cues'].items():
+        request = struct.unpack_from('<H', bank, len(bank)-808+cue['trailer_index']*2)[0]
+        assert request == cue['request'], 'Sound trailer mismatch'
+        row = bank[u32(bank, 0x25c)+request*60:][:60]
+        assert row[16:].split(b'\0')[0].decode('ascii').lower() == cue['bank_record'].lower()
+        raw = bank[u32(row, 0):][:u32(row, 4)]
+        assert digest(raw) == cue['sha256'], 'Cue mismatch'
+        rate, packed, decoded, flags, codec = struct.unpack_from('<HIIBB', raw)
+        assert len(raw) == packed+12 and codec == 99
+        assert rate == cue['rate'] and decoded == cue['samples']*2
+        path = cache / cue['bank_record']
+        path.write_bytes(raw)
+        target = out / (path.stem+'.wav')
+        subprocess.run(['ffmpeg', '-v', 'error', '-y', '-i', str(path), '-ac', '1', '-c:a', 'pcm_s16le', str(target)], check=True)
+        with wave.open(str(target)) as audio:
+            assert (audio.getframerate(), audio.getnframes(), audio.getnchannels(), audio.getsampwidth()) == (rate, cue['samples'], 1, 2)
+        result['cues'][key] = {'kind': 'audio_only', 'audio': 'res://'+str(target.relative_to(root)),
+                              'audio_samples': cue['samples'], 'duration': cue['samples']/rate, 'frames': 0, 'fps': 15}
+    shapes, _ = extract(archive, source['shape_bank']['name'])
+    assert digest(shapes) == source['shape_bank']['sha256']
+    background, _ = extract(archive, source['palette_movie'])
+    palette = None
+    for tag, payload in parse_vqa_chunks(background):
+        if tag == b'VQFR':
+            parts = dict(parse_vqa_chunks(b'FORM'+bytes(4)+b'WVQA'+payload))
+            if b'CPL0' in parts:
+                palette = parts[b'CPL0']
+                break
+    assert palette is not None and digest(palette) == source['palette_sha256']
+    for hotspot in source['hotspots']:
+        width, height, pixels = shape(shapes, hotspot['shape'])
+        assert (width, height) == (hotspot['width'], hotspot['height'])
+        assert digest(pixels) == hotspot['pixel_indices_sha256']
+        picture = Image.frombytes('P', (width, height), pixels)
+        picture.putpalette(bytes((v & 63)*4 for v in palette))
+        picture.info['transparency'] = 0
+        rgba = picture.convert('RGBA')
+        target = out / ('stone_hotspot_%d.png' % hotspot['hotspot'])
+        rgba.save(target)
+        with Image.open(target) as reread:
+            assert reread.tobytes() == rgba.tobytes()
+        result['hotspots'].append(dict(hotspot, path='res://'+str(target.relative_to(root))))
+    result['scope'] = 'Prepared media only. Hotspot images depict the seated chief, not loose stones. Native active-palette ownership and rendered/audio fidelity remain unqualified.'
+    result['files'] = {path.name: digest(path.read_bytes()) for path in sorted(out.iterdir())}
+    (out / 'attack_media.json').write_text(json.dumps(result, indent=2)+'\n')
+    print('PASS CHUT attack media: 63 frames, 103634 attack samples, two cues, two source hotspot images')
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--game', type=Path, required=True)
+    parser.add_argument('--output-root', type=Path, required=True)
+    args = parser.parse_args()
+    if args.output_root.exists():
+        parser.error('--output-root must be fresh')
+    prepare(args.game.resolve(), args.output_root.resolve(), json.loads(SOURCE.read_text()))
+
+
+if __name__ == '__main__':
+    main()

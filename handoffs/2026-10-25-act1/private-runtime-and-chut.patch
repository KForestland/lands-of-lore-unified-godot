new file mode 100644
index 0000000000000000000000000000000000000000..c58eb305e4175c63e7c0f16895bf6b356acfaf96
--- /dev/null
+++ b/tools/prepare_damage_shield_frames.py
@@ -0,0 +1,36 @@
+#!/usr/bin/env python3
+"""Decode pinned native Damage Shield bastion.flc; private evidence assets only."""
+import argparse,hashlib,json,struct,sys
+from pathlib import Path
+from PIL import Image
+R=Path(__file__).resolve().parent
+from lol2_material_format import sections,rgb_palette
+from lol2_creature_sprite_format import decode_rows,group_frames
+from lol2_source_format import parse_mix
+parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--game',type=Path,required=True);parser.add_argument('--out',type=Path,required=True);args=parser.parse_args()
+archive=(args.game/'LOCAL.MIX').read_bytes();row=next(r for r in parse_mix(archive) if r['key']==4018716831);raw=archive[row['offset']:row['offset']+row['size']]
+sha=lambda x:hashlib.sha256(x).hexdigest()
+assert sha(raw)=='36e0d2a0e843126e28d60411ea3e67b3db2f8ea6185bcd6d520271790736ad93'
+base=struct.unpack_from('<I',raw,0x298)[0];blob=raw[base:];s=sections(blob)
+palette=rgb_palette(blob[struct.unpack_from('<I',blob,4)[0]:][:768],6)
+rows={i:struct.unpack_from('<6H11I',blob,s[2]+i*56) for i in range((s[3]-s[2])//56)}
+
+out=args.out;assert not out.exists();out.mkdir(parents=True);result=[];books={}
+for name,count in [('bastion.flc',11)]:
+ key=0
+ for off in range(0,len(name),4):key=(((key<<1)|(key>>31))+int.from_bytes(name.encode()[off:off+4].ljust(4,b'\0'),'little'))&0xffffffff
+ selected={i:d for i,d in rows.items() if d[6]==key};groups=group_frames(selected);assert len(groups)==1 and groups[0]['count']==count
+ frames=[]
+ for fi,i in enumerate(groups[0]['frames']):
+  d=rows[i];assert d[1:4]==(320,200,0x82c6)
+  payload=blob[s[3]+d[7]:s[3]+d[7]+d[12]]
+  w,h,pixels,marked=decode_rows(payload,expected_flags=0x82c6,allow_special=True)
+  assert (w,h)==(320,200)
+  # Preserve index1 explicitly in the indexed witness; do not silently discard remap pixels.
+  Image.frombytes('L',(w,h),pixels).save(out/f'{name}_{fi:02d}_indices.png')
+  image=Image.frombytes('P',(w,h),pixels);image.putpalette(palette);image.save(out/f'{name}_{fi:02d}.png',transparency=0)
+  frames.append(dict(frame=fi,descriptor=i,indices_sha256=sha(pixels),payload_sha256=sha(payload),special_index1_pixels=pixels.count(1),transparent_rows=marked))
+ result.append(dict(name=name,count=count,width=320,height=200,name_hash=key,frames=frames))
+manifest=dict(source_sha256=sha(raw),palette_sha256=sha(palette),sequences=result,scope='Original compiled global.tex row frames; paletteindex0 transparent,index1 preserved. No native renderer/UI alignment/timing/audio claim.')
+(out/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\n')
+print('PASS11original frames,320x200; specialindex1 pixels',sum(f['special_index1_pixels'] for g in result for f in g['frames']))

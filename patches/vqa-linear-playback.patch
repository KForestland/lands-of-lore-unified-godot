+"""Causal reduction: FFmpeg's wsvqa demuxer prepends each top-level VQFL (frame-loop: CBFZ + CBPZ parts) payload to the
+next VQFR packet. Its decoder scans the packet's sub-chunks (last CBPZ index wins), decodes CBFZ into the codebook before
+rendering, renders VPTZ, then accumulates that one CBPZ. Native linear playback ignores VQFL. This script implements both
+and checks that the FFmpeg model reproduces every FFmpeg frame pixel-exactly while the native model is vqa_v2_decode."""
+import sys,hashlib,subprocess,tempfile,json
+sys.path.insert(0,'/home/bob/lol2_re_publish_20260911/tools'); sys.path.insert(0,'/home/bob/lol2_re_publish_20260911/tools/draracle')
+from lol2_vqa_decode import parse_vqa_chunks
+from extract_block_sprite_frames import lcw
+from vqa_v2_decode import partial_v2,frames
+from pathlib import Path
+import numpy as np
+from PIL import Image
+MAXCB=(0xFF00+256)*16*2
+def ff_lcw(src,dest):
+    """FFmpeg decode_format80 into an existing buffer: in place, bytestream2 reads return 0 past the end, CHECK_COUNT /
+    CHECK_COPY abort (returning an error after the bytes already written)."""
+    n=len(src);g=lambda j: src[j] if j<n else 0
+    i=0;di=0;rel=False;size=len(dest)
+    if g(0)==0: rel=True;i=1
+    while i<n:
+        op=g(i);i+=1
+        if op==0x80: break
+        if di>=size: return -1
+        if op in (0xFF,) or op&0xC0==0xC0 and op!=0xFE:
+            if op==0xFF: c=g(i)|g(i+1)<<8;s=g(i+2)|g(i+3)<<8;i+=4
+            else: c=(op&0x3F)+3;s=g(i)|g(i+1)<<8;i+=2
+            if rel: s=di-s
+            if di+c>size or s<0 or s+c>size: return -1
+            for k in range(c): dest[di+k]=dest[s+k]
+            di+=c
+        elif op==0xFE:
+            c=g(i)|g(i+1)<<8;v=g(i+2);i+=3
+            if di+c>size: return -1
+            dest[di:di+c]=bytes([v])*c;di+=c
+        elif op>0x80:
+            c=op&0x3F
+            if di+c>size: return -1
+            for k in range(c): dest[di+k]=g(i+k)
+            i+=c;di+=c
+        else:
+            c=((op&0x70)>>4)+3;s=di-(((op&0x0F)<<8)|g(i));i+=1
+            if di+c>size or s<0 or s+c>size: return -1
+            for k in range(c): dest[di+k]=dest[s+k]
+            di+=c
+    return di
+def ffmpeg_model(blob):
+    ch=parse_vqa_chunks(blob);hd=dict(ch)[b'VQHD'];per=hd[13]
+    w,h=int.from_bytes(hd[6:8],'little'),int.from_bytes(hd[8:10],'little');gx,gy=w//4,h//4;n=gx*gy

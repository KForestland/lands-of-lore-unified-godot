+#!/usr/bin/env python3
+"""Westwood VQA v2 (palette, 4x4 blocks, two-plane VPTZ pointers, 8-part CBPZ partial codebooks) frame decoder.
+
+Swap rule: the codebook assembled from N partial parts (N = VQHD byte 13; byte 12 is fps) replaces the current one after the frame
+carrying the N-th part, i.e. from the next frame on. Pointer hi byte 0xFF = solid block of colour lo; otherwise vector
+(hi*256+lo). Palette CPL0 6-bit, expanded (v<<2)|(v>>4) like FFmpeg so outputs match it wherever FFmpeg is right.
+
+Top-level VQFL chunks are seek snapshots (full CBFZ codebook + the partial parts of the group in progress) for jumping to
+loop/segment starts; the original loader only takes them with load flag 0x20 (LOLG 0x16E2B9). Linear playback ignores
+them. FFmpeg's demuxer instead appends each VQFL to the next VQFR packet and its decoder keeps the last CBPZ per packet,
+replacing that frame's own part: the next codebook group is corrupted (tools/verify_vqa_vqfl_cause.py)."""
+import sys
+sys.path.insert(0,'/home/bob/lol2_re_publish_20260911/tools'); sys.path.insert(0,'/home/bob/lol2_re_publish_20260911/tools/draracle')
+from lol2_vqa_decode import parse_vqa_chunks
+from extract_block_sprite_frames import lcw
+import numpy as np
+
+def partial_v2(blob: bytes) -> bool:
+    """True for VQA v2, 4x4 blocks, whose frames carry partial codebooks (CBPZ/CBP0)."""
+    try:
+        ch=parse_vqa_chunks(blob);hd=dict(ch).get(b'VQHD')
+    except Exception: return False
+    if not hd or int.from_bytes(hd[0:2],'little')!=2 or (hd[10],hd[11])!=(4,4): return False
+    for t,pl in ch:
+        if t==b'VQFR' and any(k in (b'CBPZ',b'CBP0') for k,_ in parse_vqa_chunks(b'FORM'+bytes(4)+b'WVQA'+pl)): return True
+    return False
+
+def frames(blob: bytes, scale='ffmpeg'):
+    ch=parse_vqa_chunks(blob);hd=dict(ch)[b'VQHD']
+    assert int.from_bytes(hd[0:2],'little')==2,'VQA v2 only'
+    w,h=int.from_bytes(hd[6:8],'little'),int.from_bytes(hd[8:10],'little');bw,bh=hd[10],hd[11];per=hd[13]
+    assert (bw,bh)==(4,4)
+    gx,gy=w//4,h//4;n=gx*gy
+    cb=None;pal=None;pending=b'';k=0
+    for t,pl in ch:
+        if t!=b'VQFR': continue
+        parts=dict(parse_vqa_chunks(b'FORM'+bytes(4)+b'WVQA'+pl))
+        if b'CPL0' in parts:
+            p=np.frombuffer(parts[b'CPL0'],np.uint8).astype(np.uint16)&63
+            pal=((p<<2)|(p>>4)).astype(np.uint8).reshape(-1,3) if scale=='ffmpeg' else (p*4).astype(np.uint8).reshape(-1,3)
+        if b'CBFZ' in parts: cb=np.frombuffer(lcw(parts[b'CBFZ']),np.uint8)
+        if b'CBF0' in parts: cb=np.frombuffer(parts[b'CBF0'],np.uint8)
+        v=lcw(parts[b'VPTZ']) if b'VPTZ' in parts else parts[b'VPT0']

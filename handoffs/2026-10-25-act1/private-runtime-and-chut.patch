index 0000000000000000000000000000000000000000..0797452b6107edf38f54d74e107f9e4de9e55c98
--- /dev/null
+++ b/scripts/lol2/player_damage_shield_checkpoint.gd
@@ -0,0 +1,45 @@
+extends RefCounted
+## Portable effect+UI checkpoint. Player update and UI draw remain separate
+## native consumers; the scene supplies the same shared tick in its frame order.
+const State=preload("res://scripts/lol2/player_damage_shield_state.gd")
+const Numbers=preload("res://scripts/lol2/save_value_rules.gd")
+static func initial() -> Dictionary:
+	return {"version":1,"effect":State.initial(),"frame":0,"counter":262144}
+static func restore(value: Variant) -> Dictionary:
+	if not value is Dictionary or value.size()!=4:return {"error":"Invalid shield presentation checkpoint."}
+	if not Numbers.integer(value.get("version"),1) or int(value.version)!=1:return {"error":"Invalid shield presentation version."}
+	var effect:=State.restore(value.get("effect"))
+	if effect.has("error"):return effect
+	if not Numbers.integer(value.get("frame"),10) or not Numbers.integer(value.get("counter"),262144):return {"error":"Invalid saved shield animation."}
+	if effect.state.phase==0 and (int(value.frame)!=0 or int(value.counter)!=262144):return {"error":"Inactive shield animation is not reset."}
+	return {"checkpoint":{"version":1,"effect":effect.state,"frame":int(value.frame),"counter":int(value.counter)}}
+static func prepare_cast(value: Variant, mana: Variant, form: Variant) -> Dictionary:
+	var loaded:=restore(value)
+	if loaded.has("error"):return loaded
+	var cast:=State.prepare_cast(loaded.checkpoint.effect,mana,form)
+	if cast.has("error"):return cast
+	if cast.cast:
+		loaded.checkpoint=initial()
+		loaded.checkpoint.effect=cast.state
+	return {"checkpoint":loaded.checkpoint,"mana":cast.mana,"cast":cast.cast,"reason":cast.get("reason","")}
+static func player_update(value: Variant, fixed_delta: Variant, running: bool) -> Dictionary:
+	var loaded:=restore(value)
+	if loaded.has("error"):return loaded
+	var advanced:=State.advance(loaded.checkpoint.effect,fixed_delta,running)
+	if advanced.has("error"):return advanced
+	loaded.checkpoint.effect=advanced.state
+	return loaded
+static func ui_update(value: Variant, fixed_delta: Variant, running: bool) -> Dictionary:
+	var loaded:=restore(value)
+	if loaded.has("error"):return loaded
+	if not Numbers.integer(fixed_delta,524288):return {"error":"Invalid shield UI delta."}
+	var packet: Dictionary=loaded.checkpoint
+	var display_frame: int=packet.frame if packet.effect.phase!=0 else -1
+	if running and packet.effect.phase!=0:
+		var advanced:=State.advance_animation(packet.frame,packet.counter,fixed_delta,packet.effect.phase==2)
+		if advanced.has("error"):return advanced
+		if advanced.ended:packet=initial()
+		else:
+			packet.frame=advanced.frame
+			packet.counter=advanced.counter
+	return {"checkpoint":packet,"display_frame":display_frame}
diff --git a/scripts/lol2/player_damage_shield_state.gd b/scripts/lol2/player_damage_shield_state.gd
new file mode 100644
index 0000000000000000000000000000000000000000..5d82f19ed913142979ef5d0ad0ed2d963eae5d4b
--- /dev/null
+++ b/scripts/lol2/player_damage_shield_state.gd
@@ -0,0 +1,68 @@
+extends RefCounted
+## Native Heal charge2: D120D activates timer179 and UI29Cbit4 mitigation.
+## D2BFA expires strictly below zero; 7F423 clears mitigation at UI cycle end.
+## Scene clock and animation owner must supply their events in original order.
+const Numbers=preload("res://scripts/lol2/save_value_rules.gd")
+const DURATION=0x0e100000
+
+static func initial() -> Dictionary:
+	return {"version":1,"phase":0,"remaining":0}
+
+static func restore(value: Variant) -> Dictionary:
+	if not value is Dictionary or value.size()!=3:return {"error":"Invalid Damage Shield checkpoint."}
+	if not Numbers.integer(value.get("version"),1) or int(value.version)!=1:return {"error":"Invalid Damage Shield version."}
+	if not Numbers.integer(value.get("phase"),2) or not Numbers.integer(value.get("remaining"),DURATION):return {"error":"Invalid Damage Shield timer."}
+	if int(value.phase)!=1 and int(value.remaining)!=0:return {"error":"Inactive Damage Shield has a timer."}
+	return {"state":{"version":1,"phase":int(value.phase),"remaining":int(value.remaining)}}
+
+static func activate(value: Variant) -> Dictionary:
+	var checked:=restore(value)
+	if checked.has("error"):return checked
+	return {"state":{"version":1,"phase":1,"remaining":DURATION},"restart_animation":true}
+
+static func advance(value: Variant, fixed_delta: Variant, running: bool) -> Dictionary:
+	var checked:=restore(value)
+	if checked.has("error"):return checked
+	if not Numbers.integer(fixed_delta,524288):return {"error":"Invalid Damage Shield clock delta."}
+	var state: Dictionary=checked.state
+	if running and state.phase==1:
+		var remaining: int=state.remaining-int(fixed_delta)
+		state.remaining=maxi(0,remaining)
+		if remaining<0:state.phase=2
+	return {"state":state}
+
+static func animation_cycle_end(value: Variant) -> Dictionary:
+	var checked:=restore(value)
+	if checked.has("error"):return checked
+	if checked.state.phase==2:checked.state=initial()
+	return checked
+
+static func mitigation_active(value: Variant) -> bool:
+	var checked:=restore(value)
+	return not checked.has("error") and checked.state.phase!=0
+
+## Ordinary human/lizard casting: original 7C18B affordability precedes D0F2C.
+## Ancient-stone permission does not waive this second-charge spell's cost.
+## Returns a staged pair so the scene can commit mana and shield together.
+static func prepare_cast(value: Variant, mana: Variant, form: Variant) -> Dictionary:
+	var checked:=restore(value)
+	if checked.has("error"):return checked
+	if not Numbers.integer(mana,65535) or not Numbers.integer(form,2):return {"error":"Invalid Damage Shield caster."}
+	if int(form)==1:return {"state":checked.state,"mana":int(mana),"cast":false,"reason":"This form cannot cast"}
+	var cost:=15 if int(form)==2 else 30
+	if int(mana)<cost:return {"state":checked.state,"mana":int(mana),"cast":false,"reason":"Not enough mana"}
+	var started:=activate(checked.state)
+	return {"state":started.state,"mana":int(mana)-cost,"cast":true,"restart_animation":true}
+
+## Native 7F3D3..7F443, after drawing the input frame. Caller clears the effect
+## when ended is true; terminal native frames11/12 are never drawn or resumed.
+static func advance_animation(frame: Variant, counter: Variant, fixed_delta: Variant, pending: bool) -> Dictionary:
+	if not Numbers.integer(frame,10) or not Numbers.integer(counter,262144) or not Numbers.integer(fixed_delta,524288):return {"error":"Invalid Damage Shield animation."}
+	var next_frame:=int(frame)
+	var next_counter:=int(counter)-int(fixed_delta)
+	while next_counter<0:
+		next_counter+=262144
+		next_frame+=1
+	var ended:=next_frame>=11 and pending
+	if next_frame>=11 and not pending:next_frame=0
+	return {"frame":next_frame,"counter":next_counter,"ended":ended}

index 0000000000000000000000000000000000000000..eb168e928eee51cfcea4a62aaa06c8103e66134c
--- /dev/null
+++ b/scripts/lol2/jungle_beehive_swarm.gd
@@ -0,0 +1,68 @@
+extends RefCounted
+## Original DD104/DD190/DD1C4 and DC8B0..DC926; caller supplies native clock delta/gate.
+## Presentation, health application, audio and wall-clock adaptation belong to the host.
+const COUNTS = {39:66,40:15,41:10}
+static func validate(state: Variant) -> String:
+	if not state is Dictionary or state.size()!=4 or not state.has_all(["active","phase","frame","counter"]):return "Invalid swarm state."
+	if not state.active is bool:return "Invalid swarm active flag."
+	for key in ["phase","frame","counter"]:
+		if not (state[key] is int or state[key] is float) or not is_finite(float(state[key])) or float(state[key])!=floorf(float(state[key])):return "Invalid swarm integer."
+	if not COUNTS.has(int(state.phase)):return "Invalid swarm phase."
+	if state.frame<0 or state.frame>=COUNTS[int(state.phase)] or state.counter< -2147483648 or state.counter>2147483647:return "Invalid swarm frame or clock."
+	if not state.active and (state.frame!=0 or int(state.phase)==40):return "Invalid inactive swarm."
+	return ""
+static func initial() -> Dictionary:
+	return {"active":false,"phase":39,"frame":0,"counter":262144}
+static func trigger(state: Dictionary) -> bool:
+	if state.active:return false
+	state.active=true;state.phase=39
+	return true
+static func can_swat(state: Dictionary) -> bool:
+	return state.active and (int(state.phase)==40 or (int(state.phase)==39 and int(state.frame)>=39))
+## Original input words and screen coordinates only; host must bind physical input.
+static func native_event_admitted(event_word: int, global_flags: int) -> bool:
+	return (event_word&255) in [0x41,0x42] and (event_word&0x800)==0 and (global_flags&0x200)!=0
+static func native_click_contains(cursor: Vector2i, scale: int, origin: Vector2i, display_top: int) -> bool:
+	assert(scale>0)
+	@warning_ignore("integer_division")
+	var left: int=origin.x+340*scale/640
+	@warning_ignore("integer_division")
+	var right: int=left+200*scale/640
+	var top: int=origin.y+display_top
+	@warning_ignore("integer_division")
+	var bottom: int=top+200*scale/400
+	return cursor.x>=left and cursor.x<=right and cursor.y>=top and cursor.y<=bottom
+static func swat_native_event(state: Dictionary, event_word: int, cursor: Vector2i, scale: int, origin: Vector2i, display_top: int) -> bool:
+	if not native_event_admitted(event_word,0x200 if state.active else 0) or not can_swat(state):return false
+	if not native_click_contains(cursor,scale,origin,display_top):return false
+	return swat(state)
+static func swat(state: Dictionary) -> bool:
+	if not can_swat(state):return false
+	state.phase=41;state.frame=0
+	return true
+static func signed32(value: int) -> int:
+	value=value&0xffffffff
+	return value-4294967296 if value>=2147483648 else value
+## Consume the shared controller result once per update, without a second timer.
+## Even fixed=0 can advance a last frame in native code; paused is distinct.
+static func advance_controller(state: Dictionary, tick: Dictionary) -> Dictionary:
+	if tick.has("error"):return {"error":tick.error}
+	if not tick.get("advanced") is bool or not tick.get("status_gate") is bool:return {"error":"Invalid swarm controller tick."}
+	var fixed: Variant=tick.get("fixed")
+	if not preload("res://scripts/lol2/hive_clock_runtime.gd")._integer(fixed,524288):return {"error":"Invalid swarm controller delta."}
+	if not tick.advanced:
+		return {"phase":int(state.phase),"frame":int(state.frame),"damage_request":false} if state.active else {}
+	return advance_native(state,int(fixed),tick.status_gate)
+static func advance_native(state: Dictionary, delta_fixed: int, status_gate: bool) -> Dictionary:
+	if not state.active:return {}
+	var result={"phase":int(state.phase),"frame":int(state.frame),"damage_request":false}
+	state.counter=signed32(int(state.counter)-delta_fixed)
+	var tick: bool=state.counter<0
+	if tick:state.counter=signed32(int(state.counter)+262144)
+	if int(state.frame)>=COUNTS[int(state.phase)]-1:
+		if int(state.phase)==39:state.phase=40
+		elif int(state.phase)==41:state.active=false
+		state.frame=0
+	elif tick:state.frame=int(state.frame)+1
+	result.damage_request=int(state.phase)==40 and status_gate
+	return result

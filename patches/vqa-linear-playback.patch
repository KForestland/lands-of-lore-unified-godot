+    gx,gy=w//4,h//4;n=gx*gy
+    vq=dict(parse_vqa_chunks(b'FORM'+bytes(4)+b'WVQA'+ch[start_chunk][1]))
+    sub=parse_vqa_chunks(b'FORM'+bytes(4)+b'WVQA'+ch[start_chunk][1])
+    cb=np.frombuffer(lcw(vq[b'CBFZ']),np.uint8);parts=[v for k,v in sub if k==b'CBPZ'];pend=b''.join(parts);k=len(parts)
+    out=[]
+    for t,pl in ch[start_chunk+1:]:
+        if t!=b'VQFR':continue
+        p=dict(parse_vqa_chunks(b'FORM'+bytes(4)+b'WVQA'+pl))
+        v=lcw(p[b'VPTZ']);lo=np.frombuffer(v[:n],np.uint8).astype(np.int64);hi=np.frombuffer(v[n:2*n],np.uint8).astype(np.int64)
+        s=hi==0xff;nv=len(cb)//16;tab=cb[:nv*16].reshape(nv,4,4)
+        assert ((hi*256+lo)[~s]<nv).all()
+        blk=np.where(s[:,None,None],lo[:,None,None].astype(np.uint8),tab[np.where(s,0,hi*256+lo)])
+        out.append(pal[blk.reshape(gy,gx,4,4).transpose(0,2,1,3).reshape(h,w)])
+        if b'CBPZ' in p:
+            pend+=p[b'CBPZ'];k+=1
+            if k==per: cb=np.frombuffer(lcw(pend),np.uint8);pend=b'';k=0
+        if len(out)==24: break
+    return out

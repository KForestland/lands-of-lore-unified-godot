diff --git a/tests/beehive_damage_calculation_test.gd b/tests/beehive_damage_calculation_test.gd
new file mode 100644
index 0000000000000000000000000000000000000000..02b1dee559857825531476756b64ce5a4bca0b34
--- /dev/null
+++ b/tests/beehive_damage_calculation_test.gd
@@ -0,0 +1,23 @@
+extends SceneTree
+const Bee = preload("res://scripts/lol2/beehive_damage.gd")
+const Calculation = preload("res://scripts/lol2/hive_damage_calculation.gd")
+func _initialize() -> void:
+	var data: Dictionary=JSON.parse_string(FileAccess.get_file_as_string("res://tests/fixtures/beehive_damage_calculation_native.json"))
+	var count := 0
+	for row in data.cases:
+		var context := {"mode":2 if int(row.amount)==2 else 0,"scalar":row.scalar,"current":row.current,"descriptors":row.descriptors}
+		var before := JSON.stringify(context)
+		var actual := Bee.resolve(context)
+		if actual.has("error") or JSON.stringify(context)!=before:
+			push_error("Bee calculation refused or mutated fixture: %s" % actual);quit(1);return
+		for field in row.result:
+			var expected: Variant = row.result[field]
+			if field=="virtual84": expected=Array(expected).map(func(value): return int(value))
+			if actual[field]!=expected:
+				push_error("Bee field %s mismatch: %s vs %s" % [field,actual,row.result]);quit(1);return
+		count += 1
+	var invalid := {"amount":1,"scalar":0,"current":20,"descriptors":[],"damage_mask":8,"signature":4,"request_kind":2,"request_tag":108,"attacker_address":1}
+	if not Calculation.calculate(invalid).has("error") or not Bee.resolve({"mode":NAN}).has("error"):
+		push_error("Invalid bee request accepted");quit(1);return
+	print("PASS bee damage native calculations ",count,"; no host health or death integration")
+	quit(0)
diff --git a/tests/beehive_player_damage_test.gd b/tests/beehive_player_damage_test.gd
new file mode 100644
index 0000000000000000000000000000000000000000..db32bb6cbf82c699cb46d1d186dd86e5235b0ee2
--- /dev/null
+++ b/tests/beehive_player_damage_test.gd
@@ -0,0 +1,105 @@
+extends SceneTree
+const Damage=preload("res://scripts/lol2/beehive_player_damage.gd")
+class Magic extends Node:
+	func health() -> int:return 20
+class Items extends RefCounted:
+	var inventory: Array=["cave:captain:Burnt_Chain"]
+	func carried() -> Array:return inventory
+	func state() -> Dictionary:return {"offhand":""}
+class Host extends Node:
+	var starting_magic=Magic.new()
+	var item_effects=Items.new()
+	var player_form:=0
+	var equipped_item: String=""
+	var equipped_armor: String="cave:captain:Burnt_Chain"
+func _initialize() -> void:
+	var context: Dictionary={"mode":0,"scalar":65535,"current":20,"maximum":21,"flags229":0,"flags228":0,"flags227":0,"mode1ab":0,"flags19a":0,"global223d4":0,"descriptors":[]}
+	# Pin why the modern three-slot order is sufficient for this bee request.
+	var catalog=preload("res://scripts/lol2/item_catalog.gd")
+	for id in catalog.Defenses.ITEMS:
+		for entry in catalog.mitigation(id):
+			if (entry[1]==0 or (entry[1]&8)!=0) and (entry[2]==0 or (entry[2]&4)!=0):
+				assert(entry[0]==1 or (id=="cave:captain:Burnt_Chain" and entry==[6,8,4]))
+	var host:=Host.new();root.add_child(host);host.add_child(host.starting_magic)
+	var source:=context.duplicate(true)
+	source.merge({"ui_mode":0,"boosted":false,"optional":false,"bypass":0})
+	source.current=999;source.descriptors=[[[7,8,4]]]
+	var bound:=Damage.live_context(host,source)
+	assert(bound.current==20 and bound.scalar==0 and bound.descriptors[0]==[[6,8,4],[2,1,0],[1,0,2]])
+	assert(source.current==999 and source.descriptors==[[[7,8,4]]])
+	bound.mode=2
+	assert(Damage.prepare(bound).calculation.fixed==98304)
+	host.item_effects.inventory=[]
+	bound=Damage.live_context(host,source);bound.mode=2
+	assert(Damage.prepare(bound).calculation.fixed==131072)
+	host.item_effects.inventory=[host.equipped_armor];host.player_form=1
+	bound=Damage.live_context(host,source)
+	assert(bound.mode1ab==1 and bound.ui_mode==3)
+	assert(Damage.prepare(bound).calculation.fixed==32768) # Stable beast halves, armor excluded.
+	host.player_form=2;source.ui_mode=3
+	bound=Damage.live_context(host,source)
+	assert(bound.mode1ab==2 and bound.ui_mode==6)
+	assert(Damage.prepare(bound).loss==2) # Stable lizard doubles.
+	source.erase("boosted")
+	assert(Damage.live_context(host,source).has("error"))
+	var before:=JSON.stringify(context)
+	var hit:=Damage.prepare(context)
+	assert(hit.health==19 and hit.loss==1 and not hit.lethal)
+	assert(JSON.stringify(context)==before)
+	context.mode=2
+	assert(Damage.prepare(context).health==18)
+	# Native absorption invokes virtual84, capped by maximum; it is not damage.
+	context.descriptors=[[[9,8,4]]]
+	hit=Damage.prepare(context)
+	assert(hit.health==21 and hit.loss==0 and hit.displays==[21])
+	context.flags229=2
+	hit=Damage.prepare(context)
+	assert(hit.health==20 and hit.displays.is_empty())
+	context.flags229=0;context.current=0
+	hit=Damage.prepare(context)
+	assert(hit.health==0 and not hit.lethal and hit.displays.is_empty())
+	context.current=1;context.descriptors=[]
+	hit=Damage.prepare(context)
+	assert(hit.health==0 and hit.loss==1 and hit.lethal)
+	context.flags227=128
+	hit=Damage.prepare(context)
+	assert(hit.health==1 and not hit.lethal and hit.survive_one)
+	context.flags227=0
+	for form in [0,1,2]:
+		context.mode1ab=form
+		assert(Damage.prepare(context).health==0 and Damage.prepare(context).lethal)
+	context.mode1ab=3
+	assert(Damage.prepare(context).has("error"))
+	context.mode1ab=1;context.flags227=128
+	assert(Damage.prepare(context).has("error"))
+	context.flags227=0
+	context.mode1ab=0;context.flags19a=1
+	assert(Damage.prepare(context).has("error"))
+	context.flags19a=0
+	# Original post-calculation commit fixtures: positive-health damage requests.
+	var native: Dictionary=JSON.parse_string(FileAccess.get_file_as_string("res://tests/fixtures/beehive_health_commit_native.json"))
+	var cases:=0
+	for row in native.rows:
+		if int(row.current)==0:continue # No damage loss => finalizer is not entered.
+		context.current=int(row.current);context.flags227=int(row.flags227)
+		context.mode=2 if int(row.loss)==2 else 0
+		hit=Damage.prepare(context)
+		assert(hit.health==int(row.health_at_boundary))
+		assert(hit.lethal==(row.dispatch=="death_health_zero"))
+		assert(hit.survive_one==(row.dispatch=="survive_one"))
+		cases+=1
+	assert(cases==2048)
+	context.flags227=0
+	context.current=20;context.flags228=8
+	assert(Damage.prepare(context).has("error"))
+	context.global223d4=1
+	hit=Damage.prepare(context)
+	assert(hit.blocked and hit.health==20 and hit.loss==0)
+	context.global223d4=0;context.flags228=0
+	context.descriptors=[[[9,8,4]]];context.erase("maximum")
+	assert(Damage.prepare(context).has("error"))
+	context.descriptors=[];context.erase("global223d4")
+	assert(Damage.prepare(context).has("error"))
+	assert(Damage.prepare(null).has("error"))
+	print("PASS staged swarm health: mode/scalar, absorption/cap/suppression, no resurrection, lethal host health0, entry gates and atomic validation; no live owner mutation")
+	quit()
diff --git a/tests/beehive_swarm_audio_test.gd b/tests/beehive_swarm_audio_test.gd
new file mode 100644
index 0000000000000000000000000000000000000000..bbde4aaf5e94aa7507033aa992b6570ecb7f748c
--- /dev/null
+++ b/tests/beehive_swarm_audio_test.gd
@@ -0,0 +1,27 @@
+extends SceneTree
+func _initialize() -> void: run.call_deferred()
+func run() -> void:
+	var audio=preload("res://scripts/lol2/beehive_swarm_audio.gd").new()
+	root.add_child(audio)
+	assert(not audio.begin(true))
+	assert(not audio.setup(NAN,0.0).is_empty())
+	assert(audio.setup(-6.0,-3.0).is_empty()) # Supplied test gain, not native gain claim.
+	assert(not audio.setup(0.0,0.0).is_empty())
+	assert(audio.buzz.stream.loop_mode==AudioStreamWAV.LOOP_FORWARD)
+	assert(audio.buzz.stream.loop_end==87124 and audio.buzz.stream.mix_rate==22050)
+	assert(audio.impact.stream.loop_mode==AudioStreamWAV.LOOP_DISABLED)
+	assert(audio.impact.stream.mix_rate==22050)
+	assert(absf(audio.impact.stream.get_length()-8864.0/22050.0)<0.00001)
+	assert(audio.begin(true) and audio.buzz.playing)
+	var playback=audio.buzz.get_stream_playback()
+	assert(not audio.begin(true) and audio.buzz.get_stream_playback()==playback)
+	assert(audio.swat(true) and not audio.buzz.playing and audio.impact.playing)
+	assert(not audio.swat(true))
+	audio.stop_all();assert(not audio.active and not audio.impact.playing)
+	assert(audio.begin(false) and not audio.buzz.playing)
+	assert(not audio.begin(true) and not audio.buzz.playing)
+	assert(audio.swat(false) and not audio.buzz.playing and not audio.impact.playing)
+	assert(audio.begin(true) and audio.swat(false) and not audio.buzz.playing)
+	audio.stop_all();audio.queue_free();await process_frame
+	print("PASS native swarm audio lifecycle: looping581, finite491, no active retrigger, stop even when sound disabled; explicit test gain")
+	quit(0)

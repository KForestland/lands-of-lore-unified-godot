From 3a4c92f48374effadfdb7a7270d2a65f72515324 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Sun, 25 Oct 2026 18:47:28 +0100
Subject: [PATCH] Verify chief hut death dialogue across a new game process

---
 tests/jungle_chut_dead_restart_test.gd | 38 ++++++++++++++++++++++++++
 tests/jungle_chut_dead_test.gd         |  1 +
 tools/run_regressions.py               |  1 +
 3 files changed, 40 insertions(+)
 create mode 100644 tests/jungle_chut_dead_restart_test.gd

diff --git a/tests/jungle_chut_dead_restart_test.gd b/tests/jungle_chut_dead_restart_test.gd
new file mode 100644
index 0000000..333c32d
--- /dev/null
+++ b/tests/jungle_chut_dead_restart_test.gd
@@ -0,0 +1,38 @@
+extends SceneTree
+const Speech=preload("res://scripts/lol2/monastery_conversation.gd")
+var scene
+func _initialize() -> void: run.call_deferred()
+func run() -> void:
+	assert(not has_meta("lol2_jungle_handoff"))
+	for stage in ["mid","done"]:
+		var path: String="user://tests/chut_dead_"+stage+".json"
+		assert(FileAccess.file_exists(path),"Run jungle_chut_dead_test first to create the qualified saves.")
+		if is_instance_valid(scene):
+			scene.queue_free()
+			await process_frame
+		scene=load("res://scenes/lol2/jungle_walkthrough.tscn").instantiate();root.add_child(scene);current_scene=scene
+		for i in 1500:
+			await process_frame
+			if scene.ready_for_review:break
+		assert(scene.ready_for_review)
+		scene.process_mode=Node.PROCESS_MODE_DISABLED
+		assert(scene.quickload(path)=="")
+		var rooms=scene.monastery
+		var s: Dictionary=rooms.state()
+		assert(s.room=="CHUT" and s.conversation.sequence=="CHUT_DEAD")
+		assert(s.flags["153"]==1 and s.globals.GV_KELSRICK_DEAD==1)
+		assert(int(scene.village_gate.state().shared29)==1)
+		if stage=="mid":
+			assert(s.conversation.cursor==1 and is_equal_approx(s.conversation.elapsed,0.25))
+			assert(Speech.active(s.conversation) and rooms.view.clip.line==376)
+			rooms.advance(100.0)
+		assert(not Speech.active(s.conversation) and s.conversation.cursor==5)
+		assert(s.room=="CHUT" and rooms.view.clip.get("idle",false))
+		assert(not rooms.chut_first_update())
+		rooms.leave_room()
+		assert(s.room=="")
+		assert(rooms.enter_room("CHUT"))
+		rooms.advance(8.0)
+		assert(not Speech.active(s.conversation) and s.flags["153"]==1)
+	print("PASS new process CHUT death mid-line/completed saves: original line376 resumes, alarm/death/once-only flags persist, finish stays in room and re-entry does not repeat")
+	quit()
diff --git a/tests/jungle_chut_dead_test.gd b/tests/jungle_chut_dead_test.gd
index 556084e..7092790 100644
--- a/tests/jungle_chut_dead_test.gd
+++ b/tests/jungle_chut_dead_test.gd
@@ -44,5 +44,6 @@ func run() -> void:
 	assert(not rooms.chut_first_update())
 	var bad: Dictionary=s.duplicate(true);bad.flags["153"]=0
 	assert(Quest.validate(bad)!="")
+	assert(scene.quicksave("user://tests/chut_dead_done.json")=="")
 	print("PASS CHUT death:8 native admission cases, original5 clips/timings, alarm-before-speech, mid-line disk reload, no repeat, stays in room")
 	quit()
diff --git a/tools/run_regressions.py b/tools/run_regressions.py
index ec96866..605c778 100644
--- a/tools/run_regressions.py
+++ b/tools/run_regressions.py
@@ -25,6 +25,7 @@ CORE = PORTABLE + [(name, 'headless') for name in [
     'player_damage_shield_state_test',
     'player_damage_shield_checkpoint_test',
     'jungle_chut_dead_test',
+    'jungle_chut_dead_restart_test',
     'player_status_transport_test',
     'player_status_early_areas_test',
     'player_status_early_clocks_test',

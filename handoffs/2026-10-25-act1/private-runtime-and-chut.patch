+func _combined_equal(a: Variant,b: Variant) -> bool:
+	if a is Dictionary and b is Dictionary:
+		if a.size()!=b.size():return false
+		for key in a:
+			if not b.has(key) or not _combined_equal(a[key],b[key]):return false
+		return true
+	if a is Array and b is Array:
+		if a.size()!=b.size():return false
+		for i in a.size():
+			if not _combined_equal(a[i],b[i]):return false
+		return true
+	return a==b

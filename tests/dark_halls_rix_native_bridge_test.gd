extends SceneTree
const Rules=preload("res://scripts/lol2/dark_halls_rix_native.gd")
const Rix=preload("res://scripts/lol2/dark_halls_rix.gd")
func _initialize():run.call_deferred()
func run():
 assert(not Rules.rescue({},0).ok and not Rules.rescue({},101).ok,"Dead and above-half inputs cannot rescue")
 var rescued:Dictionary=Rules.rescue({},90)
 assert(rescued.ok,JSON.stringify(rescued))
 assert(rescued.soul_delta==2 and Rules.VM.snapshot_error(rescued.native).is_empty(),"Actual native completion100/soul2 and disk-safe receipt")
 var loaded:Dictionary=JSON.parse_string(JSON.stringify(rescued.native))
 assert(not Rules.rescue(loaded,90).ok,"Completed native100 cannot award again after JSON roundtrip, independent of mana")
 var talked:Dictionary=Rules.talk(loaded)
 assert(talked.ok,JSON.stringify(talked))
 assert(int(talked.native.state.get("rix:talk",{}).get("release_receipt",0))==1,"Actual14388 event retains named plain-status presentation receipt")
 assert(Rix.validate({"dead":false,"staff":false,"rescued":true,"native":talked.native,"talked":true}).is_empty())
 assert(Rix.validate({"dead":true,"staff":true}).is_empty(),"Old dead/staff shape stays valid")
 assert(not Rix.validate({"dead":false,"staff":true}).is_empty())
 assert(not Rix.validate({"dead":false,"staff":false,"rescued":true}).is_empty())
 print("PASS Rix real native groups/fanfix 14102/14234/14330, soul2/native100, JSON once-only guard and14388 status receipt; dead/healthy rejects and old two-field validation. Synthetic hit/health input is a rules test, no world combat claim.")
 quit()

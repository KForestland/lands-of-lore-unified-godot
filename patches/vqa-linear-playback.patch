+#!/usr/bin/env python3
+"""Original-decoder timing and FFmpeg comparison for partial-codebook VQA v2 (tools/vqa_v2_decode.py).
+
+Original loader evidence (LOLG.DAT 0x171168, CBPZ handler): parts are appended to one buffer and counted; the group is
+complete when the count reaches VQHD byte 13, then the buffer is flagged 0xA and published as the pending codebook.
+Swap-timing evidence: 'next' = codebook from the N-th part is used from the following frame (native decoder);
+'same' = used already for the frame carrying the N-th part. Counts out-of-range vector references and frames where
+the decoder agrees with FFmpeg (FFmpeg is exact on all unaffected groups) for each timing, over all cached clips."""
+import sys,json,hashlib,subprocess,tempfile
+sys.path.insert(0,'/home/bob/lol2_re_publish_20260911/tools'); sys.path.insert(0,'/home/bob/lol2_re_publish_20260911/tools/draracle')
+from lol2_vqa_decode import parse_vqa_chunks
+from extract_block_sprite_frames import lcw
+from pathlib import Path
+import numpy as np
+from PIL import Image
+from vqa_v2_decode import partial_v2
+ROOT=Path(__file__).resolve().parents[1]
+def decode(blob,timing):
+    ch=parse_vqa_chunks(blob);hd=dict(ch)[b'VQHD'];w,h=int.from_bytes(hd[6:8],'little'),int.from_bytes(hd[8:10],'little');per=hd[13]
+    gx,gy=w//4,h//4;n=gx*gy;cb=None;pal=None;pend=b'';k=0;out=[];oob=0
+    for t,pl in ch:
+        if t!=b'VQFR':continue
+        parts=dict(parse_vqa_chunks(b'FORM'+bytes(4)+b'WVQA'+pl))
+        if b'CPL0' in parts:
+            p=np.frombuffer(parts[b'CPL0'],np.uint8).astype(np.uint16)&63;pal=((p<<2)|(p>>4)).astype(np.uint8).reshape(-1,3)
+        if b'CBFZ' in parts: cb=np.frombuffer(lcw(parts[b'CBFZ']),np.uint8)
+        swap=None
+        if b'CBPZ' in parts:
+            pend+=parts[b'CBPZ'];k+=1
+            if k==per: swap=np.frombuffer(lcw(pend),np.uint8);pend=b'';k=0
+        if timing=='same' and swap is not None: cb=swap;swap_done=True
+        v=lcw(parts[b'VPTZ']);lo=np.frombuffer(v[:n],np.uint8).astype(np.int64);hi=np.frombuffer(v[n:2*n],np.uint8).astype(np.int64)
+        s=hi==0xff;idx=np.where(s,0,hi*256+lo);nv=len(cb)//16
+        oob+=int((idx[~s]>=nv).sum());idx=np.minimum(idx,nv-1)
+        tab=cb[:nv*16].reshape(nv,4,4)
+        blk=np.where(s[:,None,None],lo[:,None,None].astype(np.uint8),tab[idx])
+        out.append(pal[blk.reshape(gy,gx,4,4).transpose(0,2,1,3).reshape(h,w)])
+        if timing=='next' and swap is not None: cb=swap
+    return out,oob
+seen=set();tot={'next':[0,0,0],'same':[0,0,0]}
+for p in sorted((ROOT/'tmp').rglob('*')):
+    if p.suffix.lower()!='.vqa' or not p.is_file():continue

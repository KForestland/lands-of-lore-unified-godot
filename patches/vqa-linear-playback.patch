+        tot[timing][0]+=oob;tot[timing][1]+=agree;tot[timing][2]+=len(fr);row+= [timing,oob,agree]
+    print(row,flush=True)
+tot={k:dict(out_of_range_refs=int(v[0]),frames_equal_ffmpeg=int(v[1]),frames=int(v[2])) for k,v in tot.items()}
+assert tot['next']['out_of_range_refs']==0 and tot['same']['out_of_range_refs']>0 and tot['next']['frames_equal_ffmpeg']>tot['same']['frames_equal_ffmpeg']

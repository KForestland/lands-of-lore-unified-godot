diff --git a/scripts/lol2/player_status_executioner.gd b/scripts/lol2/player_status_executioner.gd
new file mode 100644
index 0000000000000000000000000000000000000000..0a051fec59c041d31367158af3164d4f7efadf67
--- /dev/null
+++ b/scripts/lol2/player_status_executioner.gd
@@ -0,0 +1,85 @@
+extends RefCounted
+## Private combined transaction: native actor update precedes player status.
+## Context/admission remain explicit. Actor lethal continuation is still bounded
+## by executioner_runtime; a refusal must leave every live owner unchanged.
+const Runtime=preload("res://scripts/lol2/hive_executioner_runtime.gd")
+const State=preload("res://scripts/lol2/player_swarm_state.gd")
+const Swarm=preload("res://scripts/lol2/jungle_beehive_swarm.gd")
+const Clock=preload("res://scripts/lol2/hive_clock_runtime.gd")
+const Timing=preload("res://scripts/lol2/hive_timing_state.gd")
+const Damage=preload("res://scripts/lol2/beehive_player_damage.gd")
+static func advance(host: Node, adapter: RefCounted, seconds: float, running: bool) -> Dictionary:
+	if host.executioner_runtime==null or host.get_node("Nest").phase!=3:return {"error":"Executioner is not active."}
+	var admission: Dictionary=adapter.status_admission()
+	if admission.has("error"):return admission
+	var source_context: Dictionary=adapter.admitted_context.duplicate(true)
+	var initial_quests: Dictionary=adapter.read_quests()
+	if initial_quests.has("player_damage_shield"):
+		var shield:=preload("res://scripts/lol2/player_damage_shield_checkpoint.gd").restore(initial_quests.player_damage_shield)
+		if shield.has("error"):return shield
+		source_context.optional=shield.checkpoint.effect.phase!=0
+	var context:=Damage.live_context(host,source_context)
+	if context.has("error"):return context
+	var current: int=context.current
+	var prior: Dictionary=host.executioner_runtime.checkpoint()
+	var quests: Dictionary=adapter.read_quests()
+	var loaded:=State.restore(quests)
+	if loaded.has("error"):return loaded
+	var fraction: float=quests.get("player_status_fraction",0.0)
+	var total:=seconds*1000000.0+fraction
+	var tick:=Clock.advance_reference_frame(loaded.timing.clock,floori(total),loaded.timing.phase,running)
+	if tick.has("error"):return tick
+	var trial:=Runtime.new()
+	var error: String=trial.restore(prior)
+	if not error.is_empty():return {"error":error}
+	var actor_result: Dictionary={}
+	var next_health:=current
+	if tick.advanced:
+		if int(prior.actor.target)==0x22574:
+			if not prior.has("player_damage"):return {"error":"Native actor damage context is unavailable."}
+			var actor_context: Dictionary=prior.player_damage.duplicate(true)
+			for key in ["current","maximum","flags229","global223d4","flags228","mode","descriptors"]:
+				if context.has(key):actor_context[key]=context[key]
+			actor_context.scalar=preload("res://scripts/lol2/player_defense.gd").scalar(host)
+			error=trial.bind_player_damage(actor_context)
+			if not error.is_empty():return {"error":error}
+			actor_result=trial.advance_with_player_damage(tick.delta,{"flags227":context.get("flags227"),"flags19a":context.get("flags19a"),"mode1ab":context.get("mode1ab")})
+			if not actor_result.has("error"):next_health=int(actor_result.player_damage.current)
+		else:actor_result=trial.advance(tick.delta)
+		if actor_result.has("error"):return actor_result
+	var presentation:=Swarm.advance_controller(loaded.swarm,tick) if admission.enabled else {}
+	if presentation.has("error"):return presentation
+	var shield_update:=State.advance_shield(quests,tick,admission.enabled)
+	if shield_update.has("error"):return shield_update
+	presentation.merge(shield_update)
+	var health_result: Dictionary={}
+	if presentation.get("damage_request",false):
+		context.current=next_health
+		health_result=Damage.prepare(context)
+		if health_result.has("error"):return health_result
+		next_health=int(health_result.health)
+	var final_actor: Dictionary=trial.checkpoint()
+	if final_actor.has("player_damage"):
+		if next_health>0:final_actor.player_damage.current=next_health
+		else:final_actor.erase("player_damage") # Dead host cannot supply a surviving-target snapshot.
+	error=trial.restore(final_actor)
+	if not error.is_empty():return {"error":error}
+	var timing:=Timing.checkpoint(tick.state,tick.phase,loaded.timing.executioner_a3)
+	if timing.has("error"):return timing
+	if quests.has("player_swarm"):quests.player_swarm=loaded.swarm
+	quests.hive_runtime_timing=timing.checkpoint
+	quests.player_status_fraction=total-floori(total)
+	quests[adapter.HEALTH_STAGE]={"before":current,"after":next_health}
+	# All calculations completed without touching the host. Presentation failure
+	# restores the actor before status or owned health can commit.
+	if host.starting_magic.health()!=current or host.executioner_runtime.checkpoint()!=prior:return {"error":"Combined owners changed during preparation."}
+	error=host.executioner_runtime.restore(final_actor)
+	if not error.is_empty():return {"error":error}
+	error=host._present_executioner_or_restore(prior)
+	if not error.is_empty():return {"error":error}
+	error=adapter.commit_quests(quests)
+	if not error.is_empty():
+		host.executioner_runtime.restore(prior)
+		host.get_node("Nest").present_executioner(prior)
+		return {"error":error}
+	return {"tick":tick,"presentation":presentation,"executioner":actor_result,"swarm_health":health_result,"health":next_health}
diff --git a/scripts/lol2/player_status_host.gd b/scripts/lol2/player_status_host.gd
new file mode 100644
index 0000000000000000000000000000000000000000..a3136b406f024f82245648ab8a220b46b22df1f5
--- /dev/null
+++ b/scripts/lol2/player_status_host.gd
@@ -0,0 +1,80 @@
+extends RefCounted
+## Status checkpoint boundary with optional staged health. Hive live timing wins.
+## No scheduling or gameplay activation here; caller owns the single shared tick.
+const State = preload("res://scripts/lol2/player_swarm_state.gd")
+const KEYS = ["hive_runtime_timing", "player_swarm", "player_status_fraction", "player_damage_shield"]
+var host: Node
+var hive := false
+var health_context: Callable
+var admitted_context: Dictionary={}
+const HEALTH_STAGE := "_swarm_health_transaction"
+const MANA_STAGE := "_shield_mana_transaction"
+func setup(owner_host: Node, is_hive: bool) -> void:
+	host = owner_host
+	hive = is_hive
+func read_quests() -> Dictionary:
+	var quests: Dictionary = (host.carried_quest_checkpoint if hive else host.quest_state).duplicate(true)
+	if hive and not host.runtime_timing_checkpoint.is_empty():
+		quests.hive_runtime_timing = host.runtime_timing_checkpoint.duplicate(true)
+	return quests
+func commit_quests(staged: Dictionary) -> String:
+	var restored := State.restore(staged)
+	if restored.has("error"): return restored.error
+	var planned: Variant=staged.get(HEALTH_STAGE,{})
+	if not planned is Dictionary:return "Invalid staged swarm health."
+	if not planned.is_empty():
+		for key in ["before","after"]:
+			if not preload("res://scripts/lol2/save_value_rules.gd").integer(planned.get(key),1000000):return "Invalid staged swarm health value."
+	if not planned.is_empty():
+		if host.get("starting_magic")==null or host.starting_magic.health()!=planned.before:
+			return "Player health changed during status preparation."
+	var mana_plan: Variant=staged.get(MANA_STAGE,{})
+	if not mana_plan is Dictionary:return "Invalid staged shield mana."
+	var magic_after: Dictionary={}
+	if not mana_plan.is_empty():
+		if not mana_plan.get("before") is Dictionary or not preload("res://scripts/lol2/save_value_rules.gd").integer(mana_plan.get("mana"),65535):return "Invalid shield mana plan."
+		var magic_checked:=preload("res://scripts/lol2/player_magic_state.gd").restore(mana_plan.before)
+		if magic_checked.has("error"):return magic_checked.error
+		if int(mana_plan.mana)>int(mana_plan.before.player.mana):return "Shield cast cannot create mana."
+		if host.get("starting_magic")==null or host.starting_magic.magic_state()!=mana_plan.before:return "Player mana changed during shield preparation."
+		magic_after=mana_plan.before.duplicate(true)
+		magic_after.player.mana=int(mana_plan.mana)
+		magic_after.cooldown=0.5
+	# Preserve untouched legacy envelopes; only a scheduler/activation writes keys.
+	var target: Dictionary = host.carried_quest_checkpoint if hive else host.quest_state
+	for key in KEYS:
+		if staged.has(key): target[key] = staged[key].duplicate(true) if staged[key] is Dictionary else staged[key]
+	if hive and staged.has("hive_runtime_timing"):
+		host.runtime_timing_checkpoint = restored.timing.duplicate(true)
+	if not planned.is_empty(): host.starting_magic.set_health(int(planned.after))
+	if not magic_after.is_empty():host.starting_magic.commit(magic_after)
+	return ""
+
+## The scheduler calls this on its private copy before committing clock or health.
+func consume_tick(staged: Dictionary, _tick: Dictionary, presentation: Dictionary) -> String:
+	staged.erase(HEALTH_STAGE)
+	if not presentation.get("damage_request",false):return ""
+	if not health_context.is_valid():return "Swarm damage has no live context provider."
+	var supplied: Variant=admitted_context.duplicate(true) if not admitted_context.is_empty() else health_context.call()
+	admitted_context.clear()
+	if not supplied is Dictionary:return "Invalid swarm context provider result."
+	if presentation.has("shield_mitigation"):supplied.optional=bool(presentation.shield_mitigation)
+	var Damage=preload("res://scripts/lol2/beehive_player_damage.gd")
+	var context:=Damage.live_context(host,supplied)
+	if context.has("error"):return context.error
+	var result:=Damage.prepare(context)
+	if result.has("error"):return result.error
+	staged[HEALTH_STAGE]={"before":int(context.current),"after":int(result.health)}
+	return ""
+
+## Native outer UI gate223D4 and WOM room gate223D0 skip the whole status
+## consumer. The controller provider remains owned by the shared scheduler.
+func status_admission() -> Dictionary:
+	admitted_context.clear()
+	if not health_context.is_valid():return {"error":"Status has no context provider."}
+	var supplied: Variant=health_context.call()
+	if not supplied is Dictionary:return {"error":"Invalid status context."}
+	for key in ["global223d0","global223d4"]:
+		if not preload("res://scripts/lol2/save_value_rules.gd").integer(supplied.get(key),4294967295 if key=="global223d0" else 255):return {"error":"Missing status gate: "+key}
+	admitted_context=supplied.duplicate(true)
+	return {"enabled":int(supplied.global223d0)==0 and int(supplied.global223d4)==0}
diff --git a/scripts/lol2/player_status_scene.gd b/scripts/lol2/player_status_scene.gd
new file mode 100644
index 0000000000000000000000000000000000000000..81ab40ea47f4c6b80339bbdc5736cc66f6f1a720
--- /dev/null
+++ b/scripts/lol2/player_status_scene.gd
@@ -0,0 +1,137 @@
+extends Node
+## Single scene-owned status clock. No new keys until a player effect exists.
+## Presentation/damage consumers must be bound before exposing gameplay activation.
+const Adapter = preload("res://scripts/lol2/player_status_host.gd")
+const Scheduler = preload("res://scripts/lol2/player_status_scheduler.gd")
+var adapter = Adapter.new()
+var scheduler = Scheduler.new()
+var host: Node
+var hive := false
+var running: Callable
+var dispatching := false
+var last_error := ""
+var ticks := 0
+signal advanced(result: Dictionary)
+signal swatted
+signal restored
+signal triggered
+var presentation_owner: Node
+var shield_presentation_owner: Node
+signal shield_cast
+
+## Modern display policy: recovered 320x200 frames fill the current world viewport,
+## above the indexed resolve layer (1) and beneath the shared HUD (20).
+## This claims presentation only; casting still requires the explicit player context.
+func _ready() -> void:
+	attach_shield_presentation()
+func attach_shield_presentation() -> String:
+	if is_instance_valid(shield_presentation_owner): return ""
+	if not is_instance_valid(host): return "Shield scene owner unavailable."
+	var presentation=preload("res://scripts/lol2/player_shield_presentation.gd").new()
+	presentation.layer=10
+	var error: String=presentation.setup(self,func():return get_viewport().get_visible_rect())
+	if not error.is_empty():
+		presentation.free()
+		return error
+	add_child(presentation)
+	return ""
+func setup(owner_host: Node, is_hive: bool, world_running: Callable) -> void:
+	host=owner_host;hive=is_hive;running=world_running
+	adapter.setup(host,hive)
+	scheduler.setup(adapter.read_quests,adapter.commit_quests,world_running)
+	process_mode=Node.PROCESS_MODE_ALWAYS
+func bind_health(context_provider: Callable) -> void:
+	adapter.health_context=context_provider
+	scheduler.consume_tick=adapter.consume_tick
+	scheduler.status_admission=adapter.status_admission
+func _exit_tree() -> void:
+	if is_instance_valid(scheduler): scheduler.free()
+func _physics_process(delta: float) -> void:
+	if not is_instance_valid(host) or not running.is_valid(): return
+	var effects: Dictionary=adapter.read_quests()
+	if not effects.has("player_swarm") and not effects.has("player_damage_shield"): return
+	var result=advance_seconds(delta,bool(running.call()) and not get_tree().paused)
+	if result.has("error"):
+		if str(result.error)!=last_error: last_error=str(result.error);push_error(last_error)
+	else:
+		last_error="";ticks+=1;advanced.emit(result)
+func advance_seconds(delta: float, active: bool) -> Dictionary:
+	if not is_finite(delta) or delta<0 or delta>3600: return {"error":"Invalid scene status delta."}
+	if hive and host.executioner_runtime!=null:
+		if adapter.health_context.is_valid():return preload("res://scripts/lol2/player_status_executioner.gd").advance(host,adapter,delta,active)
+		# Native actor entry owns this shared tick and its transactional presentation.
+		var q=adapter.read_quests()
+		if q.has("player_damage_shield"):return {"error":"Shield and actor updates require a bound player damage context."}
+		var fraction: Variant=q.get("player_status_fraction",0.0)
+		if not preload("res://scripts/lol2/player_swarm_state.gd").valid_fraction(fraction): return {"error":"Invalid status fraction."}
+		var total: float=delta*1000000.0+float(fraction)
+		dispatching=true
+		var actor: Dictionary=host.executioner_runtime.checkpoint().actor
+		var tick: Dictionary
+		if int(actor.target)==0x22574:
+			tick=host.executioner_advance_reference_time_with_player_damage(floori(total),active)
+		else:
+			tick=host.executioner_advance_reference_time(floori(total),active)
+		dispatching=false
+		if tick.has("error"): return tick
+		host.carried_quest_checkpoint.player_status_fraction=total-floori(total)
+		return {"tick":tick,"presentation":tick.get("swarm",{})}
+	return scheduler.advance_seconds(delta,active)
+
+## Transactional native-input boundary; physical cursor mapping is host-owned.
+func swat_native_input(event_word: int, cursor: Vector2i, scale: int, origin: Vector2i, display_top: int) -> Dictionary:
+	if not running.is_valid() or not bool(running.call()) or get_tree().paused:return {"swatted":false}
+	var staged:=adapter.read_quests()
+	var result:=preload("res://scripts/lol2/player_swarm_state.gd").swat_input(staged,event_word,cursor,scale,origin,display_top)
+	if result.has("error") or not result.swatted:return result
+	var error:=adapter.commit_quests(staged)
+	if not error.is_empty():return {"error":error}
+	swatted.emit()
+	return result
+
+func activation_available() -> bool:
+	return is_instance_valid(presentation_owner) and adapter.health_context.is_valid()
+
+func activate_swarm() -> Dictionary:
+	if not activation_available():return {"error":"Swarm presentation or health binding unavailable."}
+	if not running.is_valid() or not bool(running.call()) or get_tree().paused:return {"started":false}
+	var admission: Dictionary=adapter.status_admission()
+	if admission.has("error"):return admission
+	if not admission.enabled:return {"started":false}
+	var damage=preload("res://scripts/lol2/beehive_player_damage.gd")
+	var context: Dictionary=damage.live_context(host,adapter.admitted_context)
+	adapter.admitted_context.clear()
+	if context.has("error"):return context
+	var checked: Dictionary=damage.prepare(context)
+	if checked.has("error"):return checked
+	var staged:=adapter.read_quests()
+	var result:=preload("res://scripts/lol2/player_swarm_state.gd").trigger(staged)
+	if result.has("error") or not result.started:return result
+	var error:=adapter.commit_quests(staged)
+	if not error.is_empty():return {"error":error}
+	triggered.emit()
+	return result
+
+## Staged mana+effect activation. Only a bound presentation exposes the spell.
+func cast_damage_shield() -> Dictionary:
+	if not is_instance_valid(shield_presentation_owner) or not adapter.health_context.is_valid():return {"error":"Damage Shield presentation or player context unavailable."}
+	if not running.is_valid() or not bool(running.call()) or get_tree().paused:return {"cast":false}
+	var admission:=adapter.status_admission()
+	if admission.has("error"):return admission
+	adapter.admitted_context.clear()
+	if not admission.enabled:return {"cast":false}
+	var staged:=adapter.read_quests()
+	var loaded:=preload("res://scripts/lol2/player_swarm_state.gd").restore(staged)
+	if loaded.has("error"):return loaded
+	var Packet=preload("res://scripts/lol2/player_damage_shield_checkpoint.gd")
+	var magic: Dictionary=host.starting_magic.magic_state().duplicate(true)
+	if float(magic.get("cooldown",0))>0:return {"cast":false}
+	var cast:=Packet.prepare_cast(staged.get("player_damage_shield",Packet.initial()),magic.player.mana,host.player_form)
+	if cast.has("error") or not cast.cast:return cast
+	staged.player_damage_shield=cast.checkpoint
+	staged.hive_runtime_timing=loaded.timing
+	staged[adapter.MANA_STAGE]={"before":magic,"mana":cast.mana}
+	var error:=adapter.commit_quests(staged)
+	if not error.is_empty():return {"error":error}
+	shield_cast.emit()
+	return {"cast":true}
diff --git a/scripts/lol2/player_status_scheduler.gd b/scripts/lol2/player_status_scheduler.gd
new file mode 100644
index 0000000000000000000000000000000000000000..37e5fdb1d0fa8d2176cafd53ba7ed9bb25da67fc
--- /dev/null
+++ b/scripts/lol2/player_status_scheduler.gd
@@ -0,0 +1,67 @@
+extends Node
+## One scene-owned controller update. Hosts supply their authoritative quest
+## checkpoint and consume this same tick; no consumer advances a second clock.
+const State = preload("res://scripts/lol2/player_swarm_state.gd")
+var read_quests: Callable
+var commit_quests: Callable
+var world_running: Callable
+var consume_tick: Callable
+var status_admission: Callable
+var last_error := ""
+
+func setup(reader: Callable, writer: Callable, running: Callable, consumer: Callable = Callable()) -> void:
+	read_quests = reader
+	commit_quests = writer
+	world_running = running
+	consume_tick = consumer
+	# Continue sampling the reference provider during pause, without advancing
+	# controller consumers. The host's world gate also covers rooms and movies.
+	process_mode = Node.PROCESS_MODE_ALWAYS
+
+func _physics_process(delta: float) -> void:
+	if not read_quests.is_valid() or not commit_quests.is_valid() or not world_running.is_valid(): return
+	var result := advance_seconds(delta, bool(world_running.call()) and not get_tree().paused)
+	if result.has("error") and str(result.error) != last_error:
+		last_error = result.error
+		push_error(last_error)
+
+## Writer is called only after the tick consumer accepts. Consumer must stage its
+## own output in the supplied quest copy; it must not mutate the live host.
+func advance_microseconds(microseconds: Variant, running: bool) -> Dictionary:
+	return _advance(microseconds, running, false)
+
+func advance_seconds(seconds: Variant, running: bool) -> Dictionary:
+	return _advance(seconds, running, true)
+
+func _advance(elapsed: Variant, running: bool, seconds: bool) -> Dictionary:
+	if not read_quests.is_valid() or not commit_quests.is_valid(): return {"error":"Status scheduler has no checkpoint owner."}
+	var supplied: Variant = read_quests.call()
+	if not supplied is Dictionary: return {"error":"Status scheduler requires quest state."}
+	var staged: Dictionary = supplied.duplicate(true)
+	var microseconds: Variant = elapsed
+	if seconds:
+		if not (elapsed is int or elapsed is float) or not is_finite(float(elapsed)) or elapsed < 0 or elapsed > 3600:
+			return {"error":"Invalid status elapsed seconds."}
+		var fraction: Variant = staged.get("player_status_fraction", 0.0)
+		if not State.valid_fraction(fraction): return {"error":"Invalid status microsecond fraction."}
+		var accumulated: float = float(elapsed) * 1000000.0 + float(fraction)
+		microseconds = floori(accumulated)
+		staged.player_status_fraction = accumulated - float(microseconds)
+	var status_enabled:=true
+	if status_admission.is_valid():
+		var admission: Variant=status_admission.call()
+		if not admission is Dictionary:return {"error":"Invalid status admission result."}
+		if admission.has("error"):return admission
+		if not admission.get("enabled") is bool:return {"error":"Invalid status admission flag."}
+		status_enabled=admission.enabled
+	var result := State.advance(staged, microseconds, running, status_enabled)
+	if result.has("error"): return result
+	if consume_tick.is_valid():
+		var error: Variant = consume_tick.call(staged, result.tick, result.presentation)
+		if not error is String: return {"error":"Status consumer must return an error string."}
+		if not error.is_empty(): return {"error":error}
+	var committed: Variant = commit_quests.call(staged)
+	if not committed is String: return {"error":"Status writer must return an error string."}
+	if not committed.is_empty(): return {"error":committed}
+	last_error = ""
+	return result
diff --git a/scripts/lol2/player_status_transport.gd b/scripts/lol2/player_status_transport.gd
new file mode 100644
index 0000000000000000000000000000000000000000..82193b396dedf8a471b00f766cf4e0ca5bc584dc
--- /dev/null
+++ b/scripts/lol2/player_status_transport.gd
@@ -0,0 +1,41 @@
+extends RefCounted
+## Portable status envelope for areas whose saves do not carry all Jungle quests.
+## Validation never advances the shared clock or creates absent legacy effects.
+const State = preload("res://scripts/lol2/player_swarm_state.gd")
+const Shield = preload("res://scripts/lol2/player_damage_shield_checkpoint.gd")
+const KEYS = ["hive_runtime_timing", "player_swarm", "player_status_fraction", "player_damage_shield"]
+
+static func pack(quests: Dictionary) -> Dictionary:
+	var packet: Dictionary = {}
+	for key in KEYS:
+		if quests.has(key): packet[key] = quests[key].duplicate(true) if quests[key] is Dictionary else quests[key]
+	return packet
+
+static func restore(value: Variant) -> Dictionary:
+	if not value is Dictionary: return {"error":"Invalid player status transport."}
+	for key in value:
+		if not key in KEYS: return {"error":"Unknown player status transport field."}
+	var checked := State.restore(value)
+	if checked.has("error"): return checked
+	var result: Dictionary = {}
+	if value.has("hive_runtime_timing"): result.hive_runtime_timing = checked.timing
+	if value.has("player_swarm"): result.player_swarm = checked.swarm
+	if value.has("player_status_fraction"): result.player_status_fraction = float(value.player_status_fraction)
+	if value.has("player_damage_shield"): result.player_damage_shield = Shield.restore(value.player_damage_shield).checkpoint
+	return {"checkpoint":result}
+
+## Reject split ownership instead of silently choosing between two clocks/effects.
+static func merge(quests: Dictionary, packet: Variant) -> String:
+	var incoming := restore(packet)
+	if incoming.has("error"): return incoming.error
+	var existing := restore(pack(quests))
+	if existing.has("error"): return existing.error
+	for key in incoming.checkpoint:
+		if existing.checkpoint.has(key) and existing.checkpoint[key] != incoming.checkpoint[key]:
+			return "Conflicting player status handoff states."
+	for key in incoming.checkpoint: quests[key] = incoming.checkpoint[key]
+	return ""
+
+static func transport_error(inventory: Dictionary, quests: Dictionary) -> String:
+	if not inventory.has("player_status"): return ""
+	return merge(quests.duplicate(true), inventory.player_status)
diff --git a/scripts/lol2/player_swarm_presentation.gd b/scripts/lol2/player_swarm_presentation.gd
new file mode 100644
index 0000000000000000000000000000000000000000..24b7ecb3a56bc185a457a59701cf072241904438
--- /dev/null
+++ b/scripts/lol2/player_swarm_presentation.gd
@@ -0,0 +1,79 @@
+extends CanvasLayer
+## Scene integration for verified swarm components. Surface, sound enable and
+## gains are explicit host policy; this component never activates a swarm.
+const State=preload("res://scripts/lol2/player_swarm_state.gd")
+var status: Node
+var view: TextureRect
+var audio: Node
+var surface_provider: Callable
+var sound_provider: Callable
+var doubled:=true
+var last_error:=""
+func setup(owner_status: Node, surface: Callable, sound: Callable, double_pixels: bool, buzz_db: float, swat_db: float) -> String:
+	if status!=null:return "Swarm presentation already bound."
+	if not is_instance_valid(owner_status) or not surface.is_valid() or not sound.is_valid():return "Invalid swarm presentation providers."
+	var restored:=State.restore(owner_status.adapter.read_quests())
+	if restored.has("error"):return restored.error
+	if is_instance_valid(owner_status.presentation_owner):return "Swarm presentation already owned."
+	var rectangle: Variant=surface.call()
+	if not rectangle is Rect2 or not sound.call() is bool:return "Invalid swarm presentation policy."
+	var candidate=preload("res://scripts/lol2/beehive_swarm_view.gd").new()
+	var error: String=candidate.place_on_surface(rectangle,double_pixels)
+	if not error.is_empty():candidate.free();return error
+	var sound_node=preload("res://scripts/lol2/beehive_swarm_audio.gd").new()
+	error=sound_node.setup(buzz_db,swat_db)
+	if not error.is_empty():candidate.free();sound_node.free();return error
+	status=owner_status;surface_provider=surface;sound_provider=sound;doubled=double_pixels
+	view=candidate;audio=sound_node;add_child(view);add_child(audio)
+	status.advanced.connect(_advanced)
+	status.swatted.connect(_swatted)
+	status.restored.connect(_restored)
+	status.triggered.connect(_triggered)
+	var initial_error:=refresh()
+	if initial_error.is_empty():status.presentation_owner=self
+	return initial_error
+func refresh(presentation: Dictionary = {}) -> String:
+	var loaded:=State.restore(status.adapter.read_quests())
+	if loaded.has("error"):return loaded.error
+	var rectangle: Variant=surface_provider.call()
+	var enabled: Variant=sound_provider.call()
+	if not rectangle is Rect2 or not enabled is bool:return "Invalid swarm presentation policy."
+	var error: String=view.place_on_surface(rectangle,doubled)
+	if not error.is_empty():return error
+	var swarm: Dictionary=loaded.swarm
+	if swarm.active and int(swarm.phase)!=41:audio.begin(enabled)
+	elif audio.active:audio.active=false;audio.buzz.stop()
+	if presentation.has_all(["phase","frame"]):view.show_frame(int(presentation.phase),int(presentation.frame))
+	elif swarm.active:view.show_frame(int(swarm.phase),int(swarm.frame))
+	else:view.dismiss()
+	return ""
+func _advanced(result: Dictionary) -> void:
+	last_error=refresh(result.get("presentation",{}))
+func _swatted() -> void:
+	var enabled: Variant=sound_provider.call()
+	if not enabled is bool:last_error="Invalid swarm sound policy.";return
+	audio.swat(enabled)
+	last_error=refresh()
+func handle_mouse(event: InputEventMouseButton) -> bool:
+	if status==null or not event.pressed or event.button_index not in [MOUSE_BUTTON_LEFT,MOUSE_BUTTON_RIGHT]:return false
+	var rectangle: Variant=surface_provider.call()
+	if not rectangle is Rect2 or not rectangle.position.is_finite() or not rectangle.size.is_finite() or rectangle.size.x<=0 or rectangle.size.y<=0:return false
+	# Host rectangle represents original gameplay pixels, excluding letterbox rows.
+	var point: Vector2=(event.position-rectangle.position)*Vector2(640,400)/rectangle.size
+	if not point.is_finite():return false
+	var cursor:=Vector2i(floori(point.x),floori(point.y)+40)
+	var word:=0x41 if event.button_index==MOUSE_BUTTON_LEFT else 0x42
+	var result: Dictionary=status.swat_native_input(word,cursor,640,Vector2i.ZERO,40)
+	last_error=str(result.get("error",""))
+	return bool(result.get("swatted",false))
+func _input(event: InputEvent) -> void:
+	if event is InputEventMouseButton and handle_mouse(event):get_viewport().set_input_as_handled()
+
+## A load replaces runtime sound ownership. Resume an active buzz; never replay
+## an old swat impact. Stream position is not part of the portable quest packet.
+func _restored() -> void:
+	audio.stop_all()
+	last_error=refresh()
+
+func _triggered() -> void:
+	last_error=refresh()
diff --git a/scripts/lol2/player_swarm_state.gd b/scripts/lol2/player_swarm_state.gd
new file mode 100644
index 0000000000000000000000000000000000000000..1fa5d6bad0132d8a3afff3b7426fe2cec25437f4
--- /dev/null
+++ b/scripts/lol2/player_swarm_state.gd
@@ -0,0 +1,81 @@
+extends RefCounted
+## Shared quest checkpoint adapter for the native swarm and controller.
+## The scene scheduler must call this exactly once per update, then distribute
+## the returned tick to other controller consumers. This is not a second clock.
+const Swarm = preload("res://scripts/lol2/jungle_beehive_swarm.gd")
+const Clock = preload("res://scripts/lol2/hive_clock_runtime.gd")
+const Timing = preload("res://scripts/lol2/hive_timing_state.gd")
+
+static func valid_fraction(value: Variant) -> bool:
+	return (value is int or value is float) and is_finite(float(value)) and value >= 0 and value < 1
+
+static func restore(quests: Dictionary) -> Dictionary:
+	if quests.has("player_status_fraction") and not valid_fraction(quests.player_status_fraction):
+		return {"error":"Invalid status microsecond fraction."}
+	if (quests.has("player_swarm") or quests.has("player_damage_shield")) and not quests.has("hive_runtime_timing"):
+		return {"error":"Player status checkpoint requires its shared controller clock."}
+	if quests.has("player_damage_shield"):
+		var shield:=preload("res://scripts/lol2/player_damage_shield_checkpoint.gd").restore(quests.player_damage_shield)
+		if shield.has("error"):return shield
+	var swarm: Variant = quests.get("player_swarm", Swarm.initial())
+	var error := Swarm.validate(swarm)
+	if not error.is_empty(): return {"error":error}
+	var timing: Dictionary
+	if quests.has("hive_runtime_timing"):
+		timing = Timing.restore(quests.hive_runtime_timing)
+	else:
+		timing = Timing.checkpoint(Clock.initial_state(), 0, 0)
+	if timing.has("error"): return timing
+	var normalized: Dictionary = swarm.duplicate(true)
+	for key in ["phase", "frame", "counter"]: normalized[key] = int(normalized[key])
+	return {"swarm":normalized, "timing":timing.checkpoint}
+
+## No mutations on invalid input. Existing executioner A3 and unrelated quests survive.
+static func advance(quests: Dictionary, microseconds: Variant, running: bool, status_enabled: bool = true) -> Dictionary:
+	var loaded := restore(quests)
+	if loaded.has("error"): return loaded
+	var timing: Dictionary = loaded.timing
+	var tick := Clock.advance_reference_frame(timing.clock, microseconds, timing.phase, running)
+	if tick.has("error"): return tick
+	var presentation := Swarm.advance_controller(loaded.swarm, tick) if status_enabled else {}
+	if presentation.has("error"): return presentation
+	var shield:=advance_shield(quests,tick,status_enabled)
+	if shield.has("error"):return shield
+	presentation.merge(shield)
+	var saved := Timing.checkpoint(tick.state, tick.phase, timing.executioner_a3)
+	if saved.has("error"): return saved
+	quests.hive_runtime_timing = saved.checkpoint
+	if quests.has("player_swarm") or not quests.has("player_damage_shield"):
+		quests.player_swarm = loaded.swarm
+	return {"tick":tick, "presentation":presentation}
+
+static func trigger(quests: Dictionary) -> Dictionary:
+	var loaded := restore(quests)
+	if loaded.has("error"): return loaded
+	var started := Swarm.trigger(loaded.swarm)
+	quests.player_swarm = loaded.swarm
+	quests.hive_runtime_timing = loaded.timing
+	return {"started":started}
+
+## Coordinates/event words are native values supplied by the scene input adapter.
+## Refused input leaves even a legacy quest envelope byte-for-byte unchanged.
+static func swat_input(quests: Dictionary, event_word: int, cursor: Vector2i, scale: int, origin: Vector2i, display_top: int) -> Dictionary:
+	if scale<=0:return {"error":"Invalid swarm input scale."}
+	var loaded:=restore(quests)
+	if loaded.has("error"):return loaded
+	if not Swarm.swat_native_event(loaded.swarm,event_word,cursor,scale,origin,display_top):return {"swatted":false}
+	quests.player_swarm=loaded.swarm
+	return {"swatted":true}
+
+## Player timer precedes the swarm; UI expiry follows its damage snapshot.
+## This is staged state only: no host mutation or second clock advancement.
+static func advance_shield(quests: Dictionary, tick: Dictionary, ui_enabled: bool) -> Dictionary:
+	if not quests.has("player_damage_shield"):return {}
+	var Packet=preload("res://scripts/lol2/player_damage_shield_checkpoint.gd")
+	var player:=Packet.player_update(quests.player_damage_shield,tick.fixed,tick.advanced)
+	if player.has("error"):return player

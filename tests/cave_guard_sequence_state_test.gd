extends SceneTree
const State=preload("res://scripts/lol2/cave_guard_sequence_state.gd")
func _initialize() -> void:
	var src:=State.source()
	for form in range(3):
		var s:=State.initial()
		assert(State.validate(s,src).is_empty())
		assert(State.enter(s,src,Vector2(244.648,-16447.025),-285,true,form).is_empty())
		assert(State.enter(s,src,Vector2(-9,-16615),-285,false,form).is_empty())
		assert(State.enter(s,src,Vector2(-9,-16615),-270,true,form).is_empty())
		var events:=State.enter(s,src,Vector2(-9,-16615),-285,true,form)
		assert(events.size()==1 and events[0].group==9994)
		assert(s.phase=="armed" and State.validate(s,src).is_empty())
		var armed=JSON.parse_string(JSON.stringify(s));assert(State.validate(armed,src).is_empty())
		assert(State.advance(s,src,100).is_empty() and s.phase=="armed")
		events=State.rendered(s,src);assert(events.size()==1 and events[0].group==4184)
		assert(State.rendered(s,src).is_empty())
		assert(State.validate(s,src).is_empty())
		assert(State.enter(s,src,Vector2(-9,-16615),-285,true,form).is_empty())
		for selector in range(6):
			State.advance(s,src,0.25)
			var restored=JSON.parse_string(JSON.stringify(s))
			assert(State.validate(restored,src).is_empty())
			s=State.canonical(restored)
			var before:=s.duplicate(true)
			assert(State.advance(s,src,0).is_empty() and s==before)
			assert(State.advance(s,src,-1).is_empty() and s==before)
			events=State.advance(s,src,State.duration(src,selector)-s.elapsed)
			assert(events.size()==1 and events[0].group==State.CALLBACKS[selector])
			assert(State.validate(s,src).is_empty())
		assert(s.phase=="complete")
		assert(State.advance(s,src,100).is_empty())
		var bad:=s.duplicate(true);bad.groups.pop_back();assert(not State.validate(bad,src).is_empty())
		bad=s.duplicate(true);bad.selector=4;assert(not State.validate(bad,src).is_empty())
		var all:=State.initial();State.enter(all,src,Vector2(-9,-16615),-285,true,form)
		State.rendered(all,src)
		assert(State.advance(all,src,100).size()==6 and State.validate(all,src).is_empty())
	print("PASS guard sequence: three forms, support guards, six source callback groups, JSON restore at every clip, terminal no-repeat and malformed-save rejection. Host command effects not exercised.")
	quit()

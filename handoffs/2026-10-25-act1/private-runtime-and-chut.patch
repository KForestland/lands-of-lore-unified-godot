+++ b/scripts/lol2/beehive_damage.gd
@@ -0,0 +1,11 @@
+extends RefCounted
+## Private native bee calculation only. Host health, virtual84 and death effects are separate.
+const Numbers = preload("res://scripts/lol2/save_value_rules.gd")
+const Calculation = preload("res://scripts/lol2/hive_damage_calculation.gd")
+static func resolve(context: Variant) -> Dictionary:
+	if not context is Dictionary or not Numbers.integer(context.get("mode"),255): return {"error":"Invalid bee mode input."}
+	var supplied: Dictionary = context.duplicate(true)
+	supplied.amount=2 if int(context.mode)==2 else 1
+	supplied.signature=4;supplied.damage_mask=8
+	supplied.request_kind=2;supplied.request_tag=108;supplied.attacker_address=0
+	return Calculation.calculate(supplied)
diff --git a/scripts/lol2/beehive_player_damage.gd b/scripts/lol2/beehive_player_damage.gd
new file mode 100644
index 0000000000000000000000000000000000000000..b0d6e424f865842cb16e2de2e0abeac6914569ce
--- /dev/null
+++ b/scripts/lol2/beehive_player_damage.gd
@@ -0,0 +1,66 @@
+extends RefCounted
+## Stage a swarm health result for the shared-clock transaction. No owner writes.
+## Native virtual84 ordering is retained; health0 uses the modern host death flow.
+const Damage=preload("res://scripts/lol2/beehive_damage.gd")
+const Health=preload("res://scripts/lol2/hive_player_health_adjustment.gd")
+const Numbers=preload("res://scripts/lol2/save_value_rules.gd")
+
+static func prepare(context: Variant) -> Dictionary:
+	if not context is Dictionary:return {"error":"Invalid swarm health context."}
+	if not Numbers.integer(context.get("current"),1000000):return {"error":"Invalid swarm current health."}
+	for field in ["global223d4","flags228","flags227","mode1ab","flags19a"]:
+		if not Numbers.integer(context.get(field),255):return {"error":"Missing player entry gate: "+field}
+	if int(context.global223d4)!=0:
+		return {"blocked":true,"loss":0,"health":int(context.current),"lethal":false,"displays":[]}
+	if (int(context.flags228)&8)!=0:return {"error":"Player zero-state continuation unavailable."}
+	if int(context.mode1ab)>2 or int(context.flags19a)!=0 or (int(context.mode1ab)!=0 and int(context.flags227)!=0):return {"error":"Swarm health continuation outside verified player state."}
+	var damage:=Damage.resolve(context)
+	if damage.has("error"):return damage
+	var lethal: bool=int(damage.loss)>0 and int(damage.remaining)==0
+	var surviving:=damage.duplicate(true)
+	if lethal:
+		surviving.loss=0
+		surviving.remaining=int(context.current)
+	var health:=Health.finalize(context,surviving)
+	if health.has("error"):return health
+	var survive_one: bool=lethal and (int(context.flags227)&128)!=0
+	if lethal:health.current=1 if survive_one else 0
+	return {"blocked":false,"loss":int(damage.loss),"health":int(health.current),"lethal":lethal and not survive_one,"survive_one":survive_one,"calculation":damage,"displays":health.displays}
+
+## Bind current health, stable form/UI mode and actually carried equipment.
+## This host changes form immediately: native stable UI modes are 1/3/6.
+## Difficulty, entry gates and optional mitigation remain explicit caller inputs.
+## The present catalog's only nonidentity bee equipment operation is Burnt Chain
+## (6,8,4), in the armor slot, so unused native slot ordering cannot affect bees.
+static func live_context(host: Node, source: Dictionary) -> Dictionary:
+	if host==null or host.get("starting_magic")==null or host.get("item_effects")==null:
+		return {"error":"Swarm player owners unavailable."}
+	if not Numbers.integer(host.get("player_form"),2):return {"error":"Invalid live player form."}
+	var items=host.item_effects
+	var carried: Array=items.carried()
+	var slots: Array=[null,null,null,null,null,null]
+	var catalog=preload("res://scripts/lol2/item_catalog.gd")
+	var equipped: Array=[host.get("equipped_item"),host.get("equipped_armor"),items.state().get("offhand","")]
+	var kinds: Array=["weapon","armor","offhand"]
+	for i in range(equipped.size()):
+		var id: Variant=equipped[i]
+		if not id is String:return {"error":"Invalid equipped item identity."}
+		if id.is_empty() or id not in carried:continue
+		if catalog.slot(id)!=kinds[i]:return {"error":"Equipped item has wrong slot."}
+		if not catalog.Defenses.ITEMS.has(id):return {"error":"Equipment lacks verified mitigation."}
+		slots[i]=catalog.mitigation(id)
+	var supplied:=source.duplicate(true)
+	var mitigation:=source.duplicate(true)
+	mitigation.form=int(host.player_form)
+	mitigation.ui_mode=[1,3,6][int(host.player_form)]
+	supplied.mode1ab=int(host.player_form)
+	supplied.ui_mode=mitigation.ui_mode
+	mitigation.slots=slots
+	# Null attacker bypasses the scalar for this request, including negative gear.
+	mitigation.defense_parts=[0,0,0]
+	var built:=preload("res://scripts/lol2/player_mitigation.gd").build(mitigation)
+	if built.has("error"):return built
+	supplied.current=host.starting_magic.health()
+	supplied.scalar=0
+	supplied.descriptors=built.descriptors
+	return supplied
diff --git a/scripts/lol2/beehive_swarm_audio.gd b/scripts/lol2/beehive_swarm_audio.gd
new file mode 100644
index 0000000000000000000000000000000000000000..a0dcd79d343a97b67c9b4ea5c2d6b91c1c5cce7a
--- /dev/null
+++ b/scripts/lol2/beehive_swarm_audio.gd
@@ -0,0 +1,35 @@
+extends Node
+## Original request581 repeats;491 drains once. DD1C4 stops buzz before swat.
+## Host supplies gain policy and calls only after committed trigger/swat changes.
+const ROOT="res://assets/lol2/generated/beehive_swarm_audio/"
+var buzz: AudioStreamPlayer
+var impact: AudioStreamPlayer
+var active:=false
+func setup(buzz_gain_db: float, swat_gain_db: float) -> String:
+	if buzz!=null:return "Swarm audio already configured."
+	if not is_finite(buzz_gain_db) or not is_finite(swat_gain_db):return "Invalid swarm audio gain."
+	var flies:=AudioStreamWAV.load_from_file(ROOT+"flies1.wav")
+	var swat:=AudioStreamWAV.load_from_file(ROOT+"gloop2.wav")
+	if flies==null or swat==null:return "Missing original swarm audio."
+	# One undefined source tail sample is omitted by the verified media preparer.
+	flies.loop_mode=AudioStreamWAV.LOOP_FORWARD
+	flies.loop_begin=0;flies.loop_end=87124
+	swat.loop_mode=AudioStreamWAV.LOOP_DISABLED
+	buzz=AudioStreamPlayer.new();buzz.stream=flies;buzz.volume_db=buzz_gain_db;add_child(buzz)
+	impact=AudioStreamPlayer.new();impact.stream=swat;impact.volume_db=swat_gain_db;add_child(impact)
+	return ""
+func begin(sound_enabled: bool) -> bool:
+	if buzz==null or active:return false
+	active=true
+	if sound_enabled:buzz.play()
+	return true
+func swat(sound_enabled: bool) -> bool:
+	if buzz==null or not active:return false
+	active=false
+	buzz.stop()
+	if sound_enabled:impact.play()
+	return true
+func stop_all() -> void:
+	active=false
+	if buzz!=null:buzz.stop()
+	if impact!=null:impact.stop()
diff --git a/scripts/lol2/beehive_swarm_view.gd b/scripts/lol2/beehive_swarm_view.gd
new file mode 100644
index 0000000000000000000000000000000000000000..4f9e6925f70b1590d718618ec939bea160bd2bcc
--- /dev/null
+++ b/scripts/lol2/beehive_swarm_view.gd
@@ -0,0 +1,33 @@
+extends TextureRect
+## Source-sized transparent insect overlay. Host owns viewport placement and input routing.
+const ROOT="res://assets/lol2/generated/beehive_swarm/"
+const COUNTS={39:66,40:15,41:10}
+const NAMES={39:"BugFlyIn",40:"BugLoit",41:"BugSwat"}
+var sheets: Dictionary={}
+var shown_phase := -1
+var shown_frame := -1
+func _init() -> void:
+	mouse_filter=Control.MOUSE_FILTER_IGNORE
+	texture_filter=CanvasItem.TEXTURE_FILTER_NEAREST
+	size=Vector2(316,200)
+	expand_mode=TextureRect.EXPAND_IGNORE_SIZE
+	stretch_mode=TextureRect.STRETCH_SCALE
+func show_frame(phase: int, frame: int) -> void:
+	assert(COUNTS.has(phase) and frame>=0 and frame<COUNTS[phase])
+	show()
+	if phase==shown_phase and frame==shown_frame:return
+	var path=ROOT+"%s_%d.png"%[NAMES[phase],frame/16]
+	if not sheets.has(path):sheets[path]=ImageTexture.create_from_image(Image.load_from_file(path))
+	var atlas=AtlasTexture.new();atlas.atlas=sheets[path]
+	atlas.region=Rect2((frame%4)*316,((frame%16)/4)*200,316,200)
+	texture=atlas;shown_phase=phase;shown_frame=frame
+func dismiss() -> void:
+	hide()
+
+## Affine host mapping of the original640x400 gameplay surface. Native DC845
+## selects316x200 or632x400 at its upper-left, independently of the swat rectangle.
+func place_on_surface(surface: Rect2, doubled: bool) -> String:
+	if not surface.position.is_finite() or not surface.size.is_finite() or surface.size.x<=0 or surface.size.y<=0:return "Invalid swarm gameplay surface."
+	position=surface.position
+	size=surface.size*Vector2(316,200)*(2.0 if doubled else 1.0)/Vector2(640,400)
+	return ""

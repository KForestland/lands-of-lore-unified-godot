extends SceneTree
const Rix=preload("res://scripts/lol2/dark_halls_rix.gd")
const Native=preload("res://scripts/lol2/dark_halls_rix_native.gd")
func _initialize():run.call_deferred()
func run():
 var rescued:Dictionary=Native.rescue({},90)
 assert(rescued.ok)
 assert(not Rix.validate({"dead":true,"staff":false,"rescued":true,"native":rescued.native}).is_empty(),"A rescued Rix cannot also be dead")
 assert(not Rix.validate({"dead":true,"staff":true,"rescued":true,"native":rescued.native}).is_empty(),"Rescue and staff exclude each other")
 var first:Dictionary=Native.talk(rescued.native)
 assert(first.ok)
 var again:Dictionary=Native.talk(first.native)
 assert(again.ok and again.native==first.native,"Talk is idempotent, no repeated native effects")
 assert(int(first.native.state["actor:57"].byte_0x25)==100)
 assert(not Native.talk({}).ok,"Failed talk is an explicit failure")
 # Changed source metadata/file: snapshots contain fields, not a source hash.
 var data:Dictionary=JSON.parse_string(FileAccess.get_file_as_string(Native.AREA))
 data.source={"sha256":"different edition/test source metadata","path":"changed-source"}
 var vm:=Native.VM.new()
 assert(vm.load_area_data(data).is_empty())
 assert(vm.restore(JSON.parse_string(JSON.stringify(first.native))).is_empty())
 assert(vm.field("actor:57","byte_0x25")==100 and vm.field("rix:talk","release_receipt")==1,"A source change cannot invalidate the saved receipt")
 var Rules=load("res://scripts/lol2/dark_halls_rix_spell_rules.gd")
 assert(Rules.accepts("mists1") and Rules.accepts("prism5"))
 for wrong in ["mists3","prism3","prism1","spark1",""]:assert(not Rules.accepts(wrong))
 assert(Rules.available({"learned":["mists1"]},[]) and Rules.available({"learned":["prism5"]},[]))
 assert(not Rules.available({"learned":["mists3"]},[null,"unknown","act2:L10_DC:item43:charged:white"]))
 assert(Rules.stored_id("act2:L10_DC:item45:charged:blue")=="mists1")
 assert(Rules.stored_id("act2:L14_HT:item20")=="mists1")
 assert(Rules.stored_id("darkhalls:control971u1:Prsmscrl")=="prism5")
 assert(Rules.stored_id("act2:L10_DC:item43:charged:white")=="")
 assert(Rules.available({"learned":[]},["act2:L10_DC:item45:charged:blue"]))
 assert(Rules.available({"learned":[]},["act2:L14_HT:item20"]))
 print("PASS R143 exclusive rescue/death/staff, idempotent native talk/post100, changed-source snapshot compatibility, exact learned/scroll/globe ids and wrong-level/null rejects; pure rules fixtures")
 quit()

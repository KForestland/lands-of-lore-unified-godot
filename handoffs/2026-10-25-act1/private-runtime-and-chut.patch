+	await area("res://scenes/lol2/museum_walkthrough.tscn","ready_for_review")
+	assert(Transport.pack(scene.quest_state)==status)
+	path="user://tests/status_early_museum.json"
+	assert(scene.quicksave(path)=="")
+	for key in Transport.KEYS:scene.quest_state.erase(key)
+	assert(scene.quickload(path)=="")
+	assert(Transport.pack(scene.quest_state)==status)
+	var inventory: Dictionary=scene.inventory_state()
+	await area("res://scenes/lol2/jungle_walkthrough.tscn","ready_for_review")
+	assert(scene.apply_inventory_handoff(inventory)=="")
+	assert(Transport.pack(scene.quest_state)==status)
+	var before: Dictionary=scene.quest_state.duplicate(true)
+	bad=inventory.duplicate(true);bad.player_status.player_damage_shield.counter=1
+	assert(scene.apply_inventory_handoff(bad)!="" and scene.quest_state==before)
+	assert(not scene.quest_state.has("player_swarm"))
+	var handoff: Dictionary=scene.area_handoff()
+	handoff.inventory.player_status=status.duplicate(true)
+	await area("res://scenes/lol2/hive_review.tscn","ready_for_review")
+	assert(scene.apply_area_handoff(handoff)=="")
+	assert(Transport.pack(scene.carried_quest_checkpoint)==status)
+	assert(not scene.carried_inventory.has("player_status"))
+	var rejected:=handoff.duplicate(true)
+	rejected.inventory.player_status.player_damage_shield.counter=1
+	assert(scene.apply_area_handoff(rejected)!="")
+	assert(Transport.pack(scene.carried_quest_checkpoint)==status)

+#!/usr/bin/env python3
+"""Prepare original bee media; playback lifetime/gain are separate."""
+from pathlib import Path
+import argparse,hashlib,json,struct,sys,wave
+from lol2_native_aud99 import decode_valid_mono
+R=Path(__file__).resolve().parent
+p=argparse.ArgumentParser();p.add_argument('--game',type=Path,required=True);p.add_argument('--out',type=Path,required=True);a=p.parse_args()
+if a.out.exists():p.error('Use a fresh output directory.')
+from lol2_source_format import parse_mix,u32
+arc=(a.game/'LOCALLNG.MIX').read_bytes()
+e=next(e for e in parse_mix(arc) if e['key']==1570429112);bank=arc[e['offset']:e['offset']+e['size']]
+assert hashlib.sha256(bank).hexdigest()=='e2d6df9a11a3d5bf6746911eac464c7f90efceaf7535e32a0f582dcea6afc3f6'
+prepared=[]
+for index,request,name,omitted in [(400,581,'flies1',1),(401,491,'gloop2',0)]:
+    assert struct.unpack_from('<H',bank,len(bank)-808+index*2)[0]==request
+    row=bank[u32(bank,0x25c)+request*60:][:60]
+    assert row[16:].split(b'\0')[0].decode().lower()==name+'.aud'
+    aud=bank[u32(row,0):][:u32(row,4)]
+    pcm,rate,actual_omitted=decode_valid_mono(aud)
+    assert actual_omitted==omitted and rate==22050
+    # Pins independently matched original codec execution with zero and 255 padding.
+    pins={581: '129a60b15050db19eee18c01c94d86ed5659d5ddd5ea554bc1d188621aa582f6', 491: 'f75c3cdf58b5d6f81b7a25db42386f48fa7ece7e659540818bd8592a168fb0c0'}
+    assert hashlib.sha256(pcm).hexdigest()==pins[request]
+    prepared.append((name,pcm,dict(index=index,request=request,rate=rate,samples=len(pcm)//2,omitted_samples=omitted,
+                                 source_sha256=hashlib.sha256(aud).hexdigest(),pcm_sha256=hashlib.sha256(pcm).hexdigest())))
+a.out.mkdir(parents=True)
+rows=[]
+for name,pcm,row in prepared:
+    target=a.out/(name+'.wav')
+    with wave.open(str(target),'wb') as f:
+        f.setnchannels(1);f.setsampwidth(2);f.setframerate(22050);f.writeframes(pcm)
+    row.update(file=target.name,wav_sha256=hashlib.sha256(target.read_bytes()).hexdigest());rows.append(row)
+(a.out/'manifest.json').write_text(json.dumps(dict(records=rows,scope='Original codec99 PCM verified with both native padding witnesses. Flies1 final undefined sample omitted; gloop2 complete. No playback lifetime/gain/host integration.'),indent=2)+'\n')
+print('PASS original bee audio',sum(row['samples'] for row in rows),'native-valid samples')

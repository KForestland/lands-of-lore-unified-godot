+    if hh in seen or not partial_v2(b):continue
+    seen.add(hh)
+    d=tempfile.mkdtemp();subprocess.run(['ffmpeg','-v','quiet','-y','-i',str(p),'-vsync','0',d+'/%04d.png'],check=False)

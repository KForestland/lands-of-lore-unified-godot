+#!/usr/bin/env python3
+"""Decode pinned native BugFlyIn/BugLoit/BugSwat; private evidence assets only."""
+import argparse,hashlib,json,struct,sys
+from pathlib import Path
+from PIL import Image
+R=Path(__file__).resolve().parent
+from lol2_material_format import sections,rgb_palette
+from lol2_creature_sprite_format import lcw,decode_blocks,group_frames
+from lol2_source_format import parse_mix
+parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--game',type=Path,required=True);parser.add_argument('--out',type=Path,required=True);args=parser.parse_args()
+archive=(args.game/'LOCAL.MIX').read_bytes();row=next(r for r in parse_mix(archive) if r['key']==4018716831);raw=archive[row['offset']:row['offset']+row['size']]
+sha=lambda x:hashlib.sha256(x).hexdigest()
+assert sha(raw)=='36e0d2a0e843126e28d60411ea3e67b3db2f8ea6185bcd6d520271790736ad93'
+base=struct.unpack_from('<I',raw,0x298)[0];blob=raw[base:];s=sections(blob)
+palette=rgb_palette(blob[struct.unpack_from('<I',blob,4)[0]:][:768],6)
+rows={i:struct.unpack_from('<6H11I',blob,s[2]+i*56) for i in range((s[3]-s[2])//56)}
+
+out=args.out;assert not out.exists();out.mkdir(parents=True);result=[];books={}
+for name,count in [('BugFlyIn',66),('BugLoit',15),('BugSwat',10)]:
+ key=0
+ for off in range(0,len(name),4):key=(((key<<1)|(key>>31))+int.from_bytes(name.encode()[off:off+4].ljust(4,b'\0'),'little'))&0xffffffff
+ selected={i:d for i,d in rows.items() if d[6]==key};groups=group_frames(selected);assert len(groups)==1 and groups[0]['count']==count
+ frames=[]
+ for fi,i in enumerate(groups[0]['frames']):
+  d=rows[i];assert d[1:4]==(316,200,0x1246)
+  payload=blob[s[3]+d[7]:s[3]+d[7]+d[12]];ci=struct.unpack_from('<I',payload,8)[0]
+  if ci not in books:
+   offset,allocation,packed=struct.unpack_from('<3I',blob,s[9]+ci*12);assert s[8]<=offset and offset+allocation<=s[9] and packed<=allocation
+   books[ci]=lcw(blob[offset:offset+packed])

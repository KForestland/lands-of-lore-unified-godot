index 0000000000000000000000000000000000000000..9c46f74e09b9ae1f880b3a3e3723fd9caf91d01d
--- /dev/null
+++ b/tools/lol2_native_aud99.py
@@ -0,0 +1,28 @@
+"""Original codec99 arithmetic, verified against native tables and instruction replay."""
+import struct
+STEPS=[7,8,9,10,11,12,13,14,16,17,19,21,23,25,28,31,34,37,41,45,50,55,60,66,73,80,88,97,107,118,130,143,157,173,190,209,230,253,279,307,337,371,408,449,494,544,598,658,724,796,876,963,1060,1166,1282,1411,1552,1707,1878,2066,2272,2499,2749,3024,3327,3660,4026,4428,4871,5358,5894,6484,7132,7845,8630,9493,10442,11487,12635,13899,15289,16818,18500,20350,22385,24623,27086,29794,32767]
+ADJUST=[-1,-1,-1,-1,2,4,6,8]
+def delta(step,n):
+ d=(step>>3)+((step>>2) if n&1 else 0)+((step>>1) if n&2 else 0)+(step if n&4 else 0)
+ return -d if n&8 else d
+
+def decode_valid_mono(audio):
+ rate,packed_total,declared,flags,codec=struct.unpack_from('<HIIBB',audio)
+ if (flags,codec)!=(2,99) or len(audio)!=packed_total+12:raise ValueError('Unsupported or truncated AUD')
+ offset=12;index=0;value=0;pcm=bytearray();missing=0;block_total=0
+ while offset<len(audio):
+  if offset+8>len(audio):raise ValueError('Truncated block header')
+  packed,decoded,magic=struct.unpack_from('<HHI',audio,offset)
+  end=offset+8+packed
+  if magic!=0xdeaf or end>len(audio):raise ValueError('Invalid AUD block')
+  extra=decoded-packed*4
+  if extra and not (extra==2 and end==len(audio)):raise ValueError('Unsupported decoded block size')
+  missing+=extra//2;block_total+=decoded
+  for byte in audio[offset+8:end]:
+   for nibble in [byte&15,byte>>4]:
+    value=max(-32768,min(32767,value+delta(STEPS[index],nibble)))
+    index=max(0,min(88,index+ADJUST[nibble&7]))
+    pcm+=struct.pack('<h',value)
+  offset=end
+ if block_total!=declared or len(pcm)+missing*2!=declared:raise ValueError('AUD totals disagree')
+ return bytes(pcm),rate,missing

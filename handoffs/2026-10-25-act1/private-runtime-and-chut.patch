+	var context: Dictionary={"mode":2,"maximum":30,"flags229":0,"flags228":0,"flags227":0,"mode1ab":0,"flags19a":0,"global223d4":0,"global223d0":0,"ui_mode":1,"boosted":false,"optional":false,"bypass":0}
+	adapter.health_context=func():return context
+	var scheduler:=Scheduler.new()
+	scheduler.setup(adapter.read_quests,adapter.commit_quests,func():return true,adapter.consume_tick)
+	for i in 3:assert(not scheduler.advance_microseconds(16667,true).has("error"))
+	host.quest_state.player_swarm.phase=40;host.quest_state.player_swarm.frame=0;host.quest_state.player_swarm.counter=0
+	host.quest_state.player_damage_shield={"version":1,"effect":{"version":1,"phase":2,"remaining":0},"frame":10,"counter":0}
+	host.quest_state.hive_runtime_timing.clock.status_accum=0
+	var result:=scheduler.advance_microseconds(16667,true)
+	assert(not result.has("error") and result.presentation.damage_request)
+	assert(result.presentation.shield_mitigation and result.presentation.shield_display_frame==10)
+	assert(host.starting_magic.health()==19 and host.quest_state.player_damage_shield.effect.phase==0)
+	host.quest_state.player_swarm.counter=0
+	host.quest_state.hive_runtime_timing.clock.status_accum=0
+	result=scheduler.advance_microseconds(16667,true)
+	assert(not result.has("error") and result.presentation.damage_request)
+	assert(not result.presentation.shield_mitigation and host.starting_magic.health()==17)
+	assert(not host.quest_state.has("shield_mitigation"))
+	scheduler.free()

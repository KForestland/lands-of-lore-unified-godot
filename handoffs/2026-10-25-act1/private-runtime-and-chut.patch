 	var timing_type = preload("res://scripts/lol2/hive_timing_state.gd")
 	assert(scene.executioner_advance_reference_time(16667).has("error"))
 	scene.runtime_timing_checkpoint = timing_type.checkpoint(clock_type.initial_state(),123456789,15).checkpoint
+	# Shared tick drives swarm once and commits only after executioner presentation succeeds.
+	var swarm_type = preload("res://scripts/lol2/jungle_beehive_swarm.gd")
+	var swarm = swarm_type.initial()
+	swarm_type.trigger(swarm)
+	scene.carried_quest_checkpoint.player_swarm = swarm.duplicate(true)
+	var expected_tick = clock_type.advance_reference_frame(scene.runtime_timing_checkpoint.clock,16667,scene.runtime_timing_checkpoint.phase,true)
+	var expected_swarm = swarm.duplicate(true)
+	var expected_presentation = swarm_type.advance_controller(expected_swarm,expected_tick)
+	var shared_tick = scene.executioner_advance_reference_time(16667)
+	assert(not shared_tick.has("error") and shared_tick.swarm == expected_presentation)
+	assert(scene.carried_quest_checkpoint.player_swarm == expected_swarm)
+	assert(scene.runtime_timing_checkpoint.clock == expected_tick.state)
+	var shared_before = scene.area_handoff()
+	var shared_visual = scene.get_node("Nest").executioner_visual
+	scene.get_node("Nest").executioner_visual = preload("res://scripts/lol2/hive_executioner_sprite.gd").new()
+	assert(scene.executioner_advance_reference_time(16667).has("error"))
+	assert(scene.area_handoff() == shared_before)
+	scene.get_node("Nest").executioner_visual = shared_visual
+	paused = true
+	assert(not scene.executioner_advance_reference_time(16667).advanced)
+	paused = false
+	assert(scene.carried_quest_checkpoint.player_swarm == expected_swarm)
+	# Scene dispatcher delegates to the native actor entry, with one fractional-time conversion.
+	var dispatch_before: Dictionary = scene.area_handoff()
+	var dispatcher=scene.player_status
+	dispatcher.set_physics_process(true)
+	assert(scene.executioner_advance_reference_time(16667).get("error","")=="Scene status scheduler owns the shared clock.")
+	var dispatch_clock = clock_type.advance_reference_time(scene.runtime_timing_checkpoint.clock,16666,scene.runtime_timing_checkpoint.phase,true)
+	var dispatch_result: Dictionary = dispatcher.advance_seconds(1.0/60.0,true)
+	assert(not dispatch_result.has("error"),str(dispatch_result))
+	assert(dispatch_result.tick.state==dispatch_clock.state)
+	assert(scene.runtime_timing_checkpoint.clock==dispatch_clock.state)
+	assert(absf(scene.carried_quest_checkpoint.player_status_fraction-2.0/3.0)<0.00001)
+	var dispatch_saved: Dictionary=scene.area_handoff()
+	scene.get_node("Nest").executioner_visual=preload("res://scripts/lol2/hive_executioner_sprite.gd").new()
+	assert(dispatcher.advance_seconds(1.0/60.0,true).has("error"))
+	assert(scene.area_handoff()==dispatch_saved and not dispatcher.dispatching)
+	scene.get_node("Nest").executioner_visual=shared_visual
+	dispatcher.free()
+	assert(scene.apply_area_handoff(dispatch_before).is_empty())
+	scene.set_physics_process(false)
